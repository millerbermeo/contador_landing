---
import { Icon } from 'astro-icon/components';
import WaIcon from './ui/WaIcon.astro';
import { SITE, waLink, FOOTER_LINKS, FOOTER_SERVICES, COVERAGE_LINKS } from '../data/site';

const social = [
  { label: 'Facebook', href: SITE.facebook, icon: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z' },
  { label: 'TikTok', href: SITE.tiktok, icon: 'M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.74a4.84 4.84 0 01-1.01-.05z' },
  { label: 'Instagram', href: SITE.instagram, icon: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z' },
];
---

<footer class="relative isolate overflow-hidden bg-brand-950 text-white" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Pie de página</h2>
  <div class="pointer-events-none absolute -right-40 -top-40 -z-10 h-[28rem] w-[28rem] rounded-full bg-accent/10 blur-3xl" aria-hidden="true"></div>

  <div class="container-x pb-12 pt-16 sm:pt-20">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">

      <div class="sm:col-span-2 lg:col-span-4">
        <a href="/" class="inline-flex items-center gap-3 rounded-xl" aria-label="Ir al inicio">
          <img src="/logotipo.jpeg" alt="" width="48" height="48" loading="lazy" class="h-12 w-12 rounded-full object-cover ring-1 ring-white/20" />
          <span class="leading-tight">
            <span class="block font-serif text-lg font-semibold text-white">Brian Pedraza</span>
            <span class="block text-2xs font-semibold uppercase tracking-[0.16em] text-accent">Contador Público</span>
            <span class="mt-0.5 block text-2xs text-white/65">Fundador de BP Asesorías Contables</span>
          </span>
        </a>
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-white/70">
          {SITE.fullName}, Contador Público certificado con experiencia en asesoría contable y financiera en Colombia. Comprometido con la transparencia y el crecimiento empresarial.
        </p>
        <ul class="mt-6 flex items-center gap-2" role="list">
          {social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}
                class="grid h-11 w-11 place-items-center rounded-full bg-white/[0.08] text-white/80 ring-1 ring-inset ring-white/10 transition-colors duration-150 hover:bg-accent hover:text-brand-950">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon} /></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h3 class="footer-title">Servicios</h3>
        <ul class="mt-4 space-y-1" role="list">
          {FOOTER_SERVICES.map((s) => (
            <li><a href={s.href} class="footer-link">{s.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h3 class="footer-title">Navegación</h3>
        <ul class="mt-4 space-y-1" role="list">
          {FOOTER_LINKS.map((e) => (
            <li><a href={e.href} class="footer-link">{e.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h3 class="footer-title">Cobertura</h3>
        <ul class="mt-4 space-y-1" role="list">
          {COVERAGE_LINKS.map((c) => (
            <li>
              <a href={c.href} class="footer-link gap-2">
                <Icon name="lucide:map-pin" class="h-3.5 w-3.5 text-accent" aria-hidden="true" />
                {c.label}
              </a>
            </li>
          ))}
        </ul>

        <h3 class="footer-title mt-8">Contacto</h3>
        <ul class="mt-4 space-y-1" role="list">
          <li>
            <a href={`mailto:${SITE.email}`} class="footer-link gap-2.5">
              <Icon name="lucide:mail" class="h-4 w-4 text-accent" aria-hidden="true" />
              <span class="break-all">{SITE.email}</span>
            </a>
          </li>
          <li>
            <a href={waLink()} target="_blank" rel="noopener noreferrer" class="footer-link gap-2.5">
              <WaIcon class="h-4 w-4 text-accent" />
              <span>{SITE.whatsappDisplay} (WhatsApp)</span>
            </a>
          </li>
          <li>
            <a href={`tel:${SITE.phoneRaw}`} class="footer-link gap-2.5">
              <Icon name="lucide:phone" class="h-4 w-4 text-accent" aria-hidden="true" />
              <span>{SITE.phone}</span>
            </a>
          </li>
          <li class="flex min-h-[40px] items-center gap-2.5 text-sm text-white/70">
            <Icon name="lucide:map-pin" class="h-4 w-4 text-accent" aria-hidden="true" />
            <span>{SITE.location}, Colombia</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-x flex flex-col items-center justify-between gap-3 py-6 sm:flex-row">
      <p class="text-center text-xs text-white/65">
        &copy; 2025 {SITE.fullName} — Todos los derechos reservados.
      </p>
      <a href="#" class="inline-flex min-h-[44px] items-center gap-1.5 text-xs font-medium text-white/70 transition-colors duration-150 hover:text-white">
        <Icon name="lucide:arrow-up" class="h-3.5 w-3.5" aria-hidden="true" /> Volver arriba
      </a>
    </div>
  </div>
</footer>

<style>
  .footer-title {
    font-family: theme('fontFamily.sans');
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: theme('colors.accent.DEFAULT');
  }
  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: 0.875rem;
    color: rgb(255 255 255 / 0.72);
    transition: color 150ms ease;
  }
  .footer-link:hover { color: #fff; }
  .footer-link:focus-visible { outline-color: theme('colors.accent.DEFAULT'); }
</style>
