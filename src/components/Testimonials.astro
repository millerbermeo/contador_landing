---
import { Icon } from 'astro-icon/components';
import SectionHeader from './ui/SectionHeader.astro';

/**
 * EJEMPLO: reemplaza estos datos por testimonios reales de clientes
 * (nombre, cargo/empresa, texto). Las iniciales se muestran si no hay foto.
 */
const testimonials = [
	{
		name: 'María Fernanda Rojas',
		role: 'Gerente, Comercial Rojas SAS',
		quote: 'Brian llevó mi contabilidad al día y me ayudó a evitar sanciones con la DIAN. Explica todo con claridad y siempre responde rápido.',
		initials: 'MR',
	},
	{
		name: 'Carlos Andrés Muñoz',
		role: 'Emprendedor independiente',
		quote: 'Empecé mi negocio sin saber nada de impuestos. Con su asesoría entendí mis obligaciones y ahora declaro tranquilo cada año.',
		initials: 'CM',
	},
	{
		name: 'Luisa Fernanda Trujillo',
		role: 'Persona natural declarante',
		quote: 'Atención muy personalizada y a tiempo. Resolvió mis dudas sobre la declaración de renta sin tecnicismos innecesarios.',
		initials: 'LT',
	},
];
---

<section class="section">
	<div class="container-x flex flex-col items-center gap-12 sm:gap-16">
		<SectionHeader
			eyebrow="Testimonios"
			title="Lo que dicen mis clientes"
			subtitle="Experiencias reales de personas y empresas que confiaron en la asesoría."
		/>

		<ul class="grid w-full gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6" role="list">
			{testimonials.map((t, i) => (
				<li class={`reveal ${i === 2 ? 'sm:col-span-2 lg:col-span-1' : ''}`} data-reveal-delay={i * 90}>
					<figure class="card flex h-full flex-col gap-6 p-7">
						<div class="flex gap-0.5 text-brand-600" aria-label="Valoración: 5 de 5">
							{[0, 1, 2, 3, 4].map(() => <Icon name="lucide:star" class="h-4 w-4 fill-current" aria-hidden="true" />)}
						</div>
						<blockquote class="flex-1 font-serif text-lg leading-snug tracking-[-0.01em] text-ink">
							<p>“{t.quote}”</p>
						</blockquote>
						<figcaption class="flex items-center gap-3 border-t border-border pt-5">
							<span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-brand-700 text-sm font-semibold text-white" aria-hidden="true">{t.initials}</span>
							<span class="min-w-0">
								<span class="block truncate text-sm font-semibold text-ink">{t.name}</span>
								<span class="block truncate text-xs text-muted">{t.role}</span>
							</span>
						</figcaption>
					</figure>
				</li>
			))}
		</ul>
	</div>
</section>
