---
import { Icon } from 'astro-icon/components';
import WaIcon from './ui/WaIcon.astro';
import PageHero from './ui/PageHero.astro';
import Accordion from './ui/Accordion.astro';
import { waLink } from '../data/site';
import { faqSchema } from '../data/schema';
import type { Service } from '../data/services';

interface Props { service: Service }

const { service: s } = Astro.props;
---

<PageHero
  crumbs={[
    { label: 'Inicio', href: '/' },
    { label: 'Servicios', href: '/servicios/' },
    { label: s.title },
  ]}
  icon={s.icon}
  eyebrow="Servicio"
  title={s.title}
  lead={s.heroDescription}
>
  <a href={waLink(`Hola, me gustaría recibir información sobre ${s.title}.`)} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
    <WaIcon class="h-4 w-4" /> Solicitar {s.shortTitle}
  </a>
  <a href="/contacto/" class="btn btn-secondary btn-lg">
    <Icon name="lucide:mail" class="h-4 w-4 text-brand-700" aria-hidden="true" /> Otros medios de contacto
  </a>
</PageHero>

<section class="section-tight">
  <div class="container-x grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-14 xl:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="flex min-w-0 flex-col gap-6">

      <div class="grid gap-5 md:grid-cols-2">
        <article class="card reveal p-6 sm:p-7">
          <h2 class="flex items-center gap-3 text-h3">
            <span class="icon-tile h-10 w-10 rounded-lg"><Icon name="lucide:check-circle" class="h-5 w-5" aria-hidden="true" /></span>
            ¿Qué incluye?
          </h2>
          <ul class="mt-6 space-y-3" role="list">
            {s.features.map((f) => (
              <li class="flex items-start gap-2.5 text-[0.9375rem] leading-relaxed text-ink-soft">
                <Icon name="lucide:check" class="mt-1 h-4 w-4 text-brand-600" aria-hidden="true" />
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </article>

        <article class="card reveal p-6 sm:p-7" data-reveal-delay="80">
          <h2 class="flex items-center gap-3 text-h3">
            <span class="icon-tile h-10 w-10 rounded-lg"><Icon name="lucide:zap" class="h-5 w-5" aria-hidden="true" /></span>
            Beneficios
          </h2>
          <ul class="mt-6 space-y-3" role="list">
            {s.benefits.map((b) => (
              <li class="flex items-start gap-2.5 text-[0.9375rem] leading-relaxed text-ink-soft">
                <Icon name="lucide:trending-up" class="mt-1 h-4 w-4 text-brand-600" aria-hidden="true" />
                <span>{b}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>

      <article class="card reveal bg-sunken p-6 shadow-none sm:p-7">
        <h2 class="flex items-center gap-3 text-h3">
          <span class="icon-tile h-10 w-10 rounded-lg bg-surface"><Icon name="lucide:users" class="h-5 w-5" aria-hidden="true" /></span>
          ¿Para quién es este servicio?
        </h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2" role="list">
          {s.who.map((w) => (
            <li class="flex items-center gap-3 rounded-xl border border-border bg-surface p-3.5">
              <Icon name="lucide:user-check" class="h-5 w-5 text-brand-700" aria-hidden="true" />
              <span class="text-sm font-medium text-ink">{w}</span>
            </li>
          ))}
        </ul>
      </article>

      {s.faq.length > 0 && (
        <div class="reveal mt-6">
          <script type="application/ld+json" is:inline set:html={JSON.stringify({
            '@context': 'https://schema.org',
            ...faqSchema(s.faq),
          })} />
          <h2 class="text-h3">Preguntas frecuentes sobre {s.title.toLowerCase()}</h2>
          <Accordion class="mt-6" name={`faq-${s.slug}`} items={s.faq} />
        </div>
      )}
    </div>

    <aside class="lg:sticky lg:top-24 lg:self-start" aria-labelledby="cta-servicio">
      <div class="reveal relative isolate overflow-hidden rounded-panel bg-brand-dark p-7 text-white shadow-float sm:p-8">
        <div class="pointer-events-none absolute -right-20 -top-20 -z-10 h-56 w-56 rounded-full bg-accent/20 blur-3xl" aria-hidden="true"></div>
        <h2 id="cta-servicio" class="text-h3 text-white">¿Listo para empezar?</h2>
        <p class="mt-3 text-white/80">Contáctenos hoy y reciba una asesoría personalizada sin compromiso.</p>
        <a href={waLink(`Hola, quiero contratar el servicio de ${s.title}.`)} target="_blank" rel="noopener noreferrer"
          class="btn btn-inverse btn-lg btn-block mt-6 !whitespace-normal text-center">
          <WaIcon class="h-5 w-5" /> Contratar {s.shortTitle}
        </a>
      </div>
    </aside>
  </div>
</section>
