---
import { Icon } from 'astro-icon/components';
import SectionHeader from './ui/SectionHeader.astro';
import WaIcon from './ui/WaIcon.astro';
import { waLink } from '../data/site';

const tarifas = [
	{
		servicio: 'Asesoría Básica',
		descripcion: 'Dudas generales sobre impuestos, registros contables simples y trámites ante la DIAN.',
		precio: '$30.000 – $50.000',
		moneda: 'COP',
		badge: null,
		destacado: false,
		whatsapp: 'Hola, me interesa la asesoría básica. ¿Podría darme más información?',
	},
	{
		servicio: 'Asesoría Especializada',
		descripcion: 'Planeación tributaria, gestión de nómina, estructuración de costos y liquidación de impuestos complejos.',
		precio: '$150.000 – $300.000',
		moneda: 'COP',
		badge: 'Popular',
		destacado: true,
		whatsapp: 'Hola, me interesa la asesoría especializada. ¿Podría darme más información?',
	},
	{
		servicio: 'Asesoría para Empresas o PYMES',
		descripcion: 'Paquete mensual que incluye asesorías y soporte contable constante para su empresa.',
		precio: '$300.000 – $1.500.000',
		moneda: 'COP / mes',
		badge: null,
		destacado: false,
		whatsapp: 'Hola, me interesa el paquete para empresas o PYMES. ¿Podría darme más información?',
	},
	{
		servicio: 'Consultoría Puntual',
		descripcion: 'Paquetes de asesoría por horas determinadas a precios más accesibles.',
		precio: 'Precio personalizado',
		moneda: '',
		badge: 'Flexible',
		destacado: false,
		whatsapp: 'Hola, me interesa una consultoría puntual. ¿Podría darme más información?',
	},
];
---

<section id="precios" class="section bg-bg scroll-mt-20">
	<div class="container-x flex flex-col items-center gap-14">
		<SectionHeader
			eyebrow="Planes y Tarifas"
			title="Precios Claros y Accesibles"
			subtitle="Elija el plan que mejor se adapte a sus necesidades. Sin costos ocultos."
		/>

		<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch w-full pt-3">
			{tarifas.map((t, i) => (
				<div
					class:list={[
						'reveal relative rounded-card bg-surface flex flex-col p-7 transition-all duration-300 hover:-translate-y-1',
						t.destacado
							? 'border-2 border-accent shadow-glow'
							: 'border border-border shadow-soft hover:shadow-lift hover:border-accent',
					]}
					data-reveal-delay={i * 100}
				>
					{t.badge && (
						<span class:list={[
							'absolute -top-3 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full text-[0.7rem] font-bold uppercase tracking-wider',
							t.destacado ? 'bg-accent text-brand-900' : 'bg-brand-700 text-white',
						]}>
							{t.badge}
						</span>
					)}

					<h3 class="text-lg mb-3">{t.servicio}</h3>

					<div class="mb-5">
						<div class="font-serif text-2xl font-semibold leading-tight text-brand-700">{t.precio}</div>
						{t.moneda && <div class="text-xs font-medium text-muted mt-0.5">{t.moneda}</div>}
					</div>

					<p class="text-muted text-sm leading-relaxed flex-1 mb-6">{t.descripcion}</p>

					<div class="w-full h-px bg-border mb-6"></div>

					<a
						href={waLink(t.whatsapp)}
						target="_blank"
						rel="noopener noreferrer"
						class:list={[
							'inline-flex items-center justify-center gap-2 w-full min-h-[44px] px-5 rounded-full font-semibold text-sm transition-all duration-300',
							t.destacado
								? 'bg-brand-500 text-white shadow-soft hover:bg-brand-600 hover:shadow-lift'
								: 'border border-brand-500 text-brand-700 hover:bg-brand-500 hover:text-white',
						]}
					>
						<WaIcon class="w-4 h-4" /> Consultar precio
					</a>
				</div>
			))}
		</div>

		<p class="reveal text-center text-sm text-muted max-w-2xl">
			Los precios pueden variar según la complejidad y el alcance de cada caso.
			<a href={waLink('Hola, quisiera una cotización personalizada.')} target="_blank" rel="noopener noreferrer"
				class="inline-flex items-center gap-1 text-brand-600 font-medium hover:text-brand-700 ml-1">
				Contáctenos para una cotización personalizada
				<Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
			</a>
		</p>
	</div>
</section>
