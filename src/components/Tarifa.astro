---
import { Icon } from 'astro-icon/components';
import SectionHeader from './ui/SectionHeader.astro';
import WaIcon from './ui/WaIcon.astro';
import { waLink } from '../data/site';

const tarifas = [
	{
		servicio: 'Asesoría Básica',
		descripcion: 'Dudas generales sobre impuestos, registros contables simples y trámites ante la DIAN.',
		precio: '$30.000 – $50.000',
		moneda: 'COP',
		badge: null,
		destacado: false,
		whatsapp: 'Hola, me interesa la asesoría básica. ¿Podría darme más información?',
	},
	{
		servicio: 'Asesoría Especializada',
		descripcion: 'Planeación tributaria, gestión de nómina, estructuración de costos y liquidación de impuestos complejos.',
		precio: '$150.000 – $300.000',
		moneda: 'COP',
		badge: 'Popular',
		destacado: true,
		whatsapp: 'Hola, me interesa la asesoría especializada. ¿Podría darme más información?',
	},
	{
		servicio: 'Asesoría para Empresas o PYMES',
		descripcion: 'Paquete mensual que incluye asesorías y soporte contable constante para su empresa.',
		precio: '$300.000 – $1.500.000',
		moneda: 'COP / mes',
		badge: null,
		destacado: false,
		whatsapp: 'Hola, me interesa el paquete para empresas o PYMES. ¿Podría darme más información?',
	},
	{
		servicio: 'Consultoría Puntual',
		descripcion: 'Paquetes de asesoría por horas determinadas a precios más accesibles.',
		precio: 'Precio personalizado',
		moneda: '',
		badge: 'Flexible',
		destacado: false,
		whatsapp: 'Hola, me interesa una consultoría puntual. ¿Podría darme más información?',
	},
];
---

<section id="precios" class="section">
	<div class="container-x flex flex-col items-center gap-12 sm:gap-16">
		<SectionHeader
			eyebrow="Planes y Tarifas"
			title="Precios Claros y Accesibles"
			subtitle="Elija el plan que mejor se adapte a sus necesidades. Sin costos ocultos."
		/>

		<ul class="grid w-full items-stretch gap-5 pt-3 sm:grid-cols-2 lg:grid-cols-4 lg:gap-4 xl:gap-5" role="list">
			{tarifas.map((t, i) => (
				<li
					class:list={[
						'reveal card card-interactive relative flex flex-col p-6 sm:p-7',
						t.destacado && 'border-transparent bg-brand-dark text-white shadow-float lg:-my-3 lg:py-10',
					]}
					data-reveal-delay={i * 80}
				>
					{t.badge && (
						<span class:list={[
							'absolute -top-3 left-6 rounded-full px-3 py-1 text-2xs font-bold uppercase tracking-[0.12em]',
							t.destacado ? 'bg-accent text-brand-950 shadow-lift' : 'bg-surface text-brand-700 ring-1 ring-inset ring-brand-200',
						]}>
							{t.badge}
						</span>
					)}

					<h3 class:list={['text-h4 font-sans font-semibold tracking-tight', t.destacado && 'text-white']}>{t.servicio}</h3>

					<p class="mt-4">
						<span class:list={['block font-serif text-[1.75rem] font-semibold leading-[1.1] tracking-[-0.02em] tabular-nums', t.destacado ? 'text-white' : 'text-ink']}>{t.precio}</span>
						{t.moneda && <span class:list={['mt-1 block text-xs font-medium', t.destacado ? 'text-brand-200' : 'text-muted']}>{t.moneda}</span>}
					</p>

					<p class:list={['mt-5 flex-1 text-sm leading-relaxed', t.destacado ? 'text-white/80' : 'text-muted']}>{t.descripcion}</p>

					<div class:list={['my-6 h-px w-full', t.destacado ? 'bg-white/15' : 'bg-border']} aria-hidden="true"></div>

					<a href={waLink(t.whatsapp)} target="_blank" rel="noopener noreferrer"
						aria-label={`Consultar precio: ${t.servicio}`}
						class:list={['btn btn-block', t.destacado ? 'btn-inverse' : 'btn-secondary']}>
						<WaIcon class="h-4 w-4" /> Consultar precio
					</a>
				</li>
			))}
		</ul>

		<p class="reveal max-w-2xl text-center text-sm text-muted">
			Los precios pueden variar según la complejidad y el alcance de cada caso.
			<a href={waLink('Hola, quisiera una cotización personalizada.')} target="_blank" rel="noopener noreferrer" class="link ml-1 inline-flex items-center gap-1">
				Contáctenos para una cotización personalizada
				<Icon name="lucide:arrow-right" class="h-3.5 w-3.5" aria-hidden="true" />
			</a>
		</p>
	</div>
</section>
