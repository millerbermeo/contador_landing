---
/**
 * FAQ de páginas locales en dos columnas: encabezado + enlace cruzado a la
 * otra zona de cobertura (izquierda, sticky en escritorio) y acordeón (derecha).
 */
import { Icon } from 'astro-icon/components';
import SectionHeader from '../ui/SectionHeader.astro';
import Accordion from '../ui/Accordion.astro';

interface Props {
	title: string;
	name: string;
	faqs: { q: string; a: string }[];
	other: { label: string; text: string; href: string; cta: string };
}

const { title, name, faqs, other } = Astro.props;
---

<section class="section" aria-labelledby={`${name}-titulo`}>
	<div class="container-x grid gap-10 lg:grid-cols-12 lg:gap-12">
		<div class="lg:col-span-5">
			<div class="flex flex-col gap-8 lg:sticky lg:top-28">
				<SectionHeader id={`${name}-titulo`} eyebrow="Preguntas frecuentes" title={title} align="left" />
				<aside class="reveal rounded-card bg-sunken p-6" aria-label="Otra zona de cobertura">
					<p class="flex items-center gap-2 font-semibold text-ink">
						<Icon name="lucide:map-pinned" class="h-4 w-4 text-brand-700" aria-hidden="true" />
						{other.label}
					</p>
					<p class="mt-1 text-sm text-muted">{other.text}</p>
					<a href={other.href} class="link mt-3 inline-flex min-h-[44px] items-center gap-1.5 text-sm font-semibold">
						{other.cta} <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
					</a>
				</aside>
			</div>
		</div>
		<div class="lg:col-span-7">
			<Accordion items={faqs} name={name} class="reveal" />
		</div>
	</div>
</section>
