---
import { Icon } from 'astro-icon/components';
import SectionHeader from './ui/SectionHeader.astro';
import WaIcon from './ui/WaIcon.astro';
import { waLink } from '../data/site';

const features = [
	{
		icon: 'lucide:shield-check',
		title: 'Tranquilidad y Confianza',
		description: 'Cada trabajo está enfocado en brindar tranquilidad a nuestros clientes a través de un servicio transparente y profesional.',
	},
	{
		icon: 'lucide:clipboard-check',
		title: 'Cumplimiento Garantizado',
		description: 'Aseguro cada paso de su proceso fiscal y contable, siempre oportuno y en cumplimiento con la normativa vigente.',
	},
	{
		icon: 'lucide:zap',
		title: 'Asesoramiento Experto',
		description: 'Experiencia y conocimiento listos para enfrentar cualquier reto fiscal o contable que su proyecto requiera.',
	},
];
---

<section class="section bg-brand-50/40">
	<div class="container-x flex flex-col items-center gap-14">
		<SectionHeader
			eyebrow="Diferenciadores"
			title="¿Por qué elegir <span class='text-brand-500'>mis servicios?</span>"
			subtitle="Tres razones que distinguen mi trabajo y aseguran el éxito de su empresa."
		/>

		<div class="grid md:grid-cols-3 gap-6 w-full">
			{features.map((f, i) => (
				<article class="reveal relative group bg-surface rounded-card border border-border shadow-soft p-8 overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-lift hover:border-accent" data-reveal-delay={i * 120}>
					<!-- Número grande fantasma -->
					<span class="absolute -top-4 right-2 font-serif font-semibold text-7xl text-brand-50 select-none pointer-events-none" aria-hidden="true">
						0{i + 1}
					</span>
					<div class="relative flex flex-col gap-4">
						<div class="w-14 h-14 rounded-2xl bg-accent-soft grid place-items-center group-hover:bg-brand-500 transition-colors duration-300">
							<Icon name={f.icon} class="w-7 h-7 text-brand-500 group-hover:text-white transition-colors duration-300" />
						</div>
						<h3 class="text-xl">{f.title}</h3>
						<p class="text-muted text-base leading-relaxed">{f.description}</p>
					</div>
				</article>
			))}
		</div>

		<a href={waLink('Hola, me gustaría contactarlo para una asesoría contable.')} target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp"
			class="reveal inline-flex items-center gap-2.5 min-h-[48px] px-8 rounded-full border border-brand-500 text-brand-700 font-semibold hover:bg-brand-500 hover:text-white hover:-translate-y-0.5 transition-all duration-300">
			<WaIcon class="w-5 h-5" /> ¡Contácteme ahora!
		</a>
	</div>
</section>
