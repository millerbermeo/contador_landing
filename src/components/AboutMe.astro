---
/**
 * Diferenciadores ("¿Por qué elegir mis servicios?").
 * - tone: 'dark' la convierte en banda oscura (home); 'light' en sobre-mi.
 */
import { Icon } from 'astro-icon/components';
import SectionHeader from './ui/SectionHeader.astro';

interface Props { tone?: 'light' | 'dark' }
const { tone = 'light' } = Astro.props;
const dark = tone === 'dark';

const features = [
	{
		icon: 'lucide:shield-check',
		title: 'Tranquilidad y Confianza',
		description: 'Cada trabajo está enfocado en brindar tranquilidad a nuestros clientes a través de un servicio transparente y profesional.',
	},
	{
		icon: 'lucide:clipboard-check',
		title: 'Cumplimiento Garantizado',
		description: 'Aseguro cada paso de su proceso fiscal y contable, siempre oportuno y en cumplimiento con la normativa vigente.',
	},
	{
		icon: 'lucide:zap',
		title: 'Asesoramiento Experto',
		description: 'Experiencia y conocimiento listos para enfrentar cualquier reto fiscal o contable que su proyecto requiera.',
	},
];
---

<section class:list={['section', dark && 'section-dark']}>
	<div class="container-x">
		<SectionHeader
			eyebrow="Diferenciadores"
			title={`¿Por qué elegir <span class='${dark ? 'text-accent' : 'text-brand-700'}'>mis servicios?</span>`}
			subtitle="Tres razones que distinguen mi trabajo y aseguran el éxito de su empresa."
			tone={tone}
		/>

		<ol class="section-body grid w-full gap-5 md:grid-cols-3 lg:gap-6" role="list" data-stagger="90">
			{features.map((f, i) => (
				<li class:list={[
					'reveal group relative flex flex-col gap-5 overflow-hidden rounded-card p-7 sm:p-8',
					dark ? 'border border-white/10 bg-white/[0.04]' : 'card card-interactive',
				]}>
					<div class="flex items-start justify-between">
						<span class:list={[
							'grid h-12 w-12 shrink-0 place-items-center rounded-2xl',
							dark ? 'bg-white/10 text-accent ring-1 ring-inset ring-white/15' : 'icon-tile',
						]}>
							<Icon name={f.icon} class="h-6 w-6" aria-hidden="true" />
						</span>
						<span class:list={['font-serif text-4xl font-medium leading-none tracking-tight', dark ? 'text-white/25' : 'text-border-strong']} aria-hidden="true">0{i + 1}</span>
					</div>
					<h3 class:list={[dark && 'text-white']}>{f.title}</h3>
					<p class:list={['leading-relaxed', dark ? 'text-white/75' : 'text-muted']}>{f.description}</p>
				</li>
			))}
		</ol>
	</div>
</section>
