---
import { Icon } from 'astro-icon/components';
import SectionHeader from './ui/SectionHeader.astro';
import WaIcon from './ui/WaIcon.astro';
import { waLink } from '../data/site';

const features = [
	{
		icon: 'lucide:shield-check',
		title: 'Tranquilidad y Confianza',
		description: 'Cada trabajo está enfocado en brindar tranquilidad a nuestros clientes a través de un servicio transparente y profesional.',
	},
	{
		icon: 'lucide:clipboard-check',
		title: 'Cumplimiento Garantizado',
		description: 'Aseguro cada paso de su proceso fiscal y contable, siempre oportuno y en cumplimiento con la normativa vigente.',
	},
	{
		icon: 'lucide:zap',
		title: 'Asesoramiento Experto',
		description: 'Experiencia y conocimiento listos para enfrentar cualquier reto fiscal o contable que su proyecto requiera.',
	},
];
---

<section class="section">
	<div class="container-x flex flex-col items-center gap-12 sm:gap-16">
		<SectionHeader
			eyebrow="Diferenciadores"
			title="¿Por qué elegir <span class='text-brand-700'>mis servicios?</span>"
			subtitle="Tres razones que distinguen mi trabajo y aseguran el éxito de su empresa."
		/>

		<ol class="grid w-full gap-5 md:grid-cols-3 lg:gap-6" role="list">
			{features.map((f, i) => (
				<li class="card card-interactive reveal group relative flex flex-col gap-5 overflow-hidden p-7 sm:p-8" data-reveal-delay={i * 90}>
					<div class="flex items-start justify-between">
						<span class="icon-tile h-12 w-12 rounded-2xl">
							<Icon name={f.icon} class="h-6 w-6" aria-hidden="true" />
						</span>
						<span class="font-serif text-4xl font-medium leading-none tracking-tight text-border-strong" aria-hidden="true">0{i + 1}</span>
					</div>
					<h3>{f.title}</h3>
					<p class="leading-relaxed text-muted">{f.description}</p>
				</li>
			))}
		</ol>

		<a href={waLink('Hola, me gustaría contactarlo para una asesoría contable.')} target="_blank" rel="noopener noreferrer"
			class="reveal btn btn-secondary btn-lg">
			<WaIcon class="h-5 w-5 text-brand-700" /> ¡Contácteme ahora!
		</a>
	</div>
</section>
