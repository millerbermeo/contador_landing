---
import { Image } from 'astro:assets';
import Qr from './Qr.astro';
import Badge from './ui/Badge.astro';
import WaIcon from './ui/WaIcon.astro';
import { Icon } from 'astro-icon/components';
import { SITE, waLink } from '../data/site';
import heroImg from '../assets/hd-max.jpg';

const credibility = [
	{ icon: 'lucide:clock', label: '+5 años de experiencia' },
	{ icon: 'lucide:badge-check', label: 'Contador Público certificado' },
	{ icon: 'lucide:handshake', label: 'Atención personalizada y cercana' },
];
---

<section id="contador" class="relative isolate overflow-hidden">
	<div class="bg-aurora pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
	<div class="bg-dots pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

	<div class="container-x pb-[clamp(3.5rem,8vw,7rem)] pt-[clamp(2.5rem,6vw,5.5rem)]">
		<div class="grid items-center gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">

			<!-- Columna texto -->
			<div class="flex flex-col items-start gap-7">
				<Badge variant="soft" class="reveal">
					<Icon name="lucide:badge-check" class="h-4 w-4" aria-hidden="true" />
					Contador Público Certificado · Colombia
				</Badge>

				<h1 class="display-title reveal" data-reveal-delay="60">
					Contabilidad <span class="mark">clara</span> para tomar <span class="text-brand-700">mejores decisiones.</span>
				</h1>

				<p class="lead reveal max-w-[34rem]" data-reveal-delay="120">
					Acompaño a empresas, emprendedores y personas naturales en la organización de su información contable, el cumplimiento de sus obligaciones tributarias y la gestión de sus finanzas.
				</p>

				<div class="reveal flex w-full flex-col gap-3 sm:w-auto sm:flex-row" data-reveal-delay="180">
					<a href="#servicios" class="btn btn-primary btn-lg">
						Ver Servicios
						<Icon name="lucide:arrow-right" class="arrow h-4 w-4" aria-hidden="true" />
					</a>
					<a href={waLink('Hola, me gustaría recibir asesoría contable. ¡Gracias!')} target="_blank" rel="noopener noreferrer"
						class="btn btn-secondary btn-lg">
						<WaIcon class="h-4 w-4 text-brand-700" /> Contactar ahora
					</a>
				</div>

				<!-- Credenciales de confianza -->
				<ul class="reveal mt-1 flex flex-wrap gap-x-6 gap-y-3 border-t border-border pt-6 text-sm font-medium text-ink-soft" data-reveal-delay="240" role="list">
					{credibility.map((c) => (
						<li class="inline-flex items-center gap-2">
							<Icon name={c.icon} class="h-4 w-4 text-brand-700" aria-hidden="true" /> {c.label}
						</li>
					))}
				</ul>
			</div>

			<!-- Columna foto -->
			<div class="reveal relative mx-auto w-full max-w-[26rem] lg:max-w-none" data-reveal-delay="120">
				<div class="relative overflow-hidden rounded-hero bg-gradient-to-b from-accent-soft via-brand-50 to-brand-100 shadow-float ring-1 ring-black/5">
					<!-- La foto tiene fondo blanco: multiply la funde con el degradado de marca -->
					<Image src={heroImg} alt={`${SITE.fullName}, Contador Público en Colombia`} width={640} height={620}
						widths={[400, 640, 788]} sizes="(min-width: 1024px) 34rem, (min-width: 640px) 26rem, 90vw"
						format="webp" loading="eager" fetchpriority="high"
						class="aspect-[1/1.05] w-full object-cover object-[50%_15%] mix-blend-multiply" />
				</div>

				<!-- Credencial (vidrio) -->
				<div class="glass-card absolute -left-3 top-6 hidden w-56 p-4 sm:block lg:-left-10">
					<div class="flex items-start gap-3">
						<span class="icon-tile h-9 w-9 rounded-lg"><Icon name="lucide:line-chart" class="h-4 w-4" aria-hidden="true" /></span>
						<div class="min-w-0">
							<p class="font-serif text-sm font-semibold leading-tight text-ink">{SITE.fullName}</p>
							<p class="mt-0.5 text-xs leading-tight text-muted">{SITE.university}</p>
						</div>
					</div>
					<span class="chip-brand mt-3 !text-2xs">
						<Icon name="lucide:check" class="h-3 w-3" aria-hidden="true" /> Tarjeta Profesional Vigente
					</span>
				</div>

				<!-- Experiencia -->
				<div class="absolute -bottom-5 right-4 rounded-2xl bg-brand-dark px-5 py-4 text-white shadow-float sm:right-6">
					<p class="font-serif text-3xl font-semibold leading-none">+5</p>
					<p class="mt-1 text-xs font-medium text-white/80">años de experiencia</p>
				</div>

				<!-- QR + cita (solo escritorio: en móvil ya se está en el teléfono) -->
				<div class="glass-card absolute -left-10 bottom-10 hidden w-60 items-center gap-3 p-3 xl:flex">
					<Qr class="h-20 w-20 rounded-lg" />
					<div>
						<p class="text-xs italic leading-snug text-ink-soft">Actuando con seguridad y transparencia para su empresa.</p>
						<p class="mt-1.5 inline-flex items-center gap-1 text-2xs font-semibold text-brand-700">
							<WaIcon class="h-3 w-3" /> Escanéame para escribirme
						</p>
					</div>
				</div>
			</div>

		</div>
	</div>
</section>

<style>
	.glass-card {
		border-radius: 1.25rem;
		background: rgba(255, 255, 255, 0.78);
		-webkit-backdrop-filter: saturate(180%) blur(16px);
		backdrop-filter: saturate(180%) blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.7);
		box-shadow: 0 1px 2px rgba(20, 28, 13, 0.04), 0 16px 32px -12px rgba(20, 28, 13, 0.18);
	}
	@media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
		.glass-card { background: #fff; -webkit-backdrop-filter: none; backdrop-filter: none; border-color: var(--border); }
	}
</style>
