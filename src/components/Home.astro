---
import { Image } from 'astro:assets';
import Loader from './Loader.astro';
import Qr from './Qr.astro';
import Badge from './ui/Badge.astro';
import WaIcon from './ui/WaIcon.astro';
import { Icon } from 'astro-icon/components';
import { SITE, waLink } from '../data/site';
import heroImg from '../assets/hd-max.jpg';

const stats = [
	{ serviceName: 'Clientes Satisfechos', percentage: 90 },
	{ serviceName: 'Transparencia', percentage: 100 },
	{ serviceName: 'Eficiencia', percentage: 100 },
];
---

<section id="contador" class="relative overflow-hidden bg-bg">
	<!-- Fondo: grid muy sutil + glow verde -->
	<div class="absolute inset-0 grid-bg opacity-[0.35] pointer-events-none" aria-hidden="true"></div>
	<div class="absolute inset-0 bg-hero-glow pointer-events-none" aria-hidden="true"></div>
	<div class="absolute -top-24 right-0 w-[38rem] h-[38rem] max-w-full rounded-full bg-accent/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

	<div class="container-x relative py-[clamp(3rem,7vw,6rem)]">
		<div class="grid lg:grid-cols-2 items-center gap-12 lg:gap-16">

			<!-- Columna texto -->
			<div class="flex flex-col items-start gap-6 order-1">
				<Badge variant="soft" class="reveal">
					<Icon name="lucide:badge-check" class="w-4 h-4 text-brand-500" />
					Contador Público Certificado · Colombia
				</Badge>

				<h1 class="reveal" data-reveal-delay="60">
					Líderes en <span class="text-brand-700">contabilidad</span>, con servicios financieros exclusivos para
					<span class="relative inline-block text-brand-500">
						personas y empresas
						<svg class="absolute -bottom-1 left-0 w-full" viewBox="0 0 300 8" fill="none" aria-hidden="true">
							<path class="hero-underline" d="M2 6 Q75 2 150 5 Q225 8 298 4" stroke="#8CC63F" stroke-width="3" stroke-linecap="round" />
						</svg>
					</span>.
				</h1>

				<p class="reveal text-muted text-base sm:text-lg leading-relaxed max-w-xl" data-reveal-delay="120">
					Aseguramos cumplimiento y optimización para llevar su empresa al siguiente nivel con transparencia y profesionalismo.
				</p>

				<div class="reveal flex flex-wrap justify-center w-full sm:w-auto sm:justify-start gap-3" data-reveal-delay="180">
					<a href="#servicios" data-scroll-to="servicios"
						class="inline-flex items-center gap-2 min-h-[44px] px-7 rounded-full bg-brand-500 text-white font-semibold text-sm shadow-soft hover:bg-brand-600 hover:shadow-lift hover:-translate-y-0.5 transition-all duration-300">
						Ver Servicios
						<Icon name="lucide:arrow-right" class="w-4 h-4" />
					</a>
					<a href={waLink('Hola, me gustaría recibir asesoría contable. ¡Gracias!')} target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp"
						class="inline-flex items-center gap-2 min-h-[44px] px-7 rounded-full border border-brand-500 text-brand-700 font-semibold text-sm hover:bg-brand-500 hover:text-white hover:-translate-y-0.5 transition-all duration-300">
						<WaIcon class="w-4 h-4" /> Contactar ahora
					</a>
				</div>

				<!-- Stats de anillo -->
				<div class="reveal flex flex-wrap gap-6 sm:gap-8 mt-2" data-reveal-delay="240">
					{stats.map((s) => <Loader percentage={s.percentage} serviceName={s.serviceName} />)}
				</div>
			</div>

			<!-- Columna foto -->
			<div class="reveal order-2 flex justify-center lg:justify-end" data-reveal-delay="120">
				<div class="relative w-64 h-64 sm:w-80 sm:h-80 lg:w-96 lg:h-96 shrink-0">
					<!-- Glow detrás de la foto -->
					<div class="absolute inset-0 rounded-full bg-accent/25 blur-3xl scale-90 pointer-events-none" aria-hidden="true"></div>

					<!-- Tarjeta credencial flotante (desktop) -->
					<div class="absolute -top-6 -right-2 lg:-right-6 bg-surface rounded-card shadow-lift p-4 z-20 w-44 border border-border hidden sm:block">
						<div class="w-10 h-10 rounded-xl bg-brand-50 grid place-items-center mb-2">
							<Icon name="lucide:line-chart" class="w-5 h-5 text-brand-500" />
						</div>
						<h4 class="font-serif font-semibold text-brand-700 text-xs leading-tight mb-0.5">{SITE.fullName}</h4>
						<p class="text-xs text-muted leading-tight mb-2">{SITE.university}</p>
						<span class="inline-flex items-center gap-1 text-[0.65rem] bg-accent-soft text-brand-700 px-2 py-1 rounded-full font-semibold border border-brand-200">
							<Icon name="lucide:check" class="w-3 h-3" /> Tarjeta Profesional Vigente
						</span>
					</div>

					<!-- Anillos decorativos -->
					<div class="absolute inset-0 rounded-full border border-accent/30 scale-[1.1] animate-pulse-soft pointer-events-none" aria-hidden="true"></div>
					<div class="absolute inset-0 rounded-full border border-accent/15 scale-[1.22] pointer-events-none" aria-hidden="true"></div>

					<!-- Foto -->
					<div class="relative w-full h-full group cursor-pointer">
						<Image src={heroImg} alt={`${SITE.fullName}, Contador Público en Colombia`} width={480} height={480}
							format="webp" loading="eager" fetchpriority="high"
							class="w-full h-full rounded-full object-cover shadow-lift border-4 border-surface ring-2 ring-accent/40" />
						<div class="absolute inset-0 rounded-full bg-brand-900/80 backdrop-blur-sm flex flex-col gap-4 items-center justify-center opacity-0 scale-95 group-hover:opacity-100 group-hover:scale-100 transition-all duration-500 ease-out p-8">
							<p class="italic text-sm font-light text-center text-white leading-relaxed translate-y-1 group-hover:translate-y-0 transition-transform duration-500 ease-out delay-75">
								Actuando con seguridad y transparencia para su empresa.
							</p>
							<div class="translate-y-1 group-hover:translate-y-0 transition-transform duration-500 ease-out delay-100">
								<Qr />
							</div>
						</div>
					</div>

					<!-- Badge experiencia -->
					<div class="absolute -bottom-4 -left-2 lg:-left-4 bg-brand-dark text-white rounded-card shadow-lift px-4 py-3 z-20">
						<div class="font-serif text-2xl sm:text-3xl font-semibold leading-none">+5</div>
						<div class="text-[0.65rem] text-white/70 font-medium mt-0.5">años de experiencia</div>
					</div>
				</div>
			</div>

		</div>
	</div>
</section>
