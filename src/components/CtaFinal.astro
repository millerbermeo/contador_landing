---
import WaIcon from './ui/WaIcon.astro';
import { waLink } from '../data/site';
---

<section class="section">
	<div class="container-x">
		<div class="reveal relative overflow-hidden rounded-[2rem] bg-brand-dark px-6 py-14 sm:px-12 sm:py-16 text-center">
			<!-- Grid + glow sutil -->
			<div class="absolute inset-0 grid-bg opacity-[0.06] pointer-events-none" aria-hidden="true"></div>
			<div class="absolute -top-16 left-1/2 -translate-x-1/2 w-[28rem] h-[28rem] max-w-full rounded-full bg-accent/15 blur-3xl pointer-events-none" aria-hidden="true"></div>

			<div class="relative flex flex-col items-center gap-6 max-w-2xl mx-auto">
				<h2 class="text-white text-3xl sm:text-4xl">¿Listo para optimizar sus finanzas?</h2>
				<p class="text-white/75 text-base sm:text-lg leading-relaxed">
					Contáctenos hoy y reciba una asesoría personalizada sin compromiso. Damos el primer paso hacia la tranquilidad financiera de su empresa.
				</p>
				<a href={waLink('Hola, quiero optimizar mis finanzas. Me gustaría una asesoría.')} target="_blank" rel="noopener noreferrer"
					class="inline-flex items-center gap-2.5 min-h-[52px] px-8 rounded-full bg-accent text-brand-900 font-bold shadow-lift hover:bg-white hover:-translate-y-0.5 transition-all duration-300">
					<WaIcon class="w-5 h-5" /> Contactar por WhatsApp
				</a>
			</div>
		</div>
	</div>
</section>
