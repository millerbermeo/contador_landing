---
import WaIcon from './ui/WaIcon.astro';
import { waLink } from '../data/site';
---

<section class="section-tight">
	<div class="container-x">
		<div class="reveal relative isolate overflow-hidden rounded-hero bg-brand-dark px-6 py-14 text-center sm:px-12 sm:py-20">
			<div class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-[26rem] w-[26rem] max-w-full -translate-x-1/2 rounded-full bg-accent/20 blur-3xl" aria-hidden="true"></div>
			<div class="pointer-events-none absolute inset-0 -z-10 opacity-[0.07] [background-image:radial-gradient(#fff_1px,transparent_1px)] [background-size:20px_20px]" aria-hidden="true"></div>

			<div class="mx-auto flex max-w-2xl flex-col items-center gap-6">
				<h2 class="text-white">¿Listo para optimizar sus finanzas?</h2>
				<p class="text-lead text-white/80">
					Contáctenos hoy y reciba una asesoría personalizada sin compromiso. Damos el primer paso hacia la tranquilidad financiera de su empresa.
				</p>
				<a href={waLink('Hola, quiero optimizar mis finanzas. Me gustaría una asesoría.')} target="_blank" rel="noopener noreferrer"
					class="btn btn-inverse btn-lg mt-2">
					<WaIcon class="h-5 w-5" /> Contactar por WhatsApp
				</a>
			</div>
		</div>
	</div>
</section>
