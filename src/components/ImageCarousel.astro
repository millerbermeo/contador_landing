---
import { Icon } from 'astro-icon/components';
import SectionHeader from './ui/SectionHeader.astro';
import { SITE } from '../data/site';

const tiktokPath = 'M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.74a4.84 4.84 0 01-1.01-.05z';

const videos = [
	{ id: '7402404368126987525', title: 'Video de asesoría contable', cite: 'https://www.tiktok.com/@bp.asesorias.contables/video/7402404368126987525' },
	{ id: '7394242102835662086', title: 'Declaración de Renta 2023 — Documentos requeridos', cite: 'https://www.tiktok.com/@bp.asesorias.contables/video/7394242102835662086' },
	{ id: '7391289223623494918', title: 'Declaración de Renta — Sanciones', cite: 'https://www.tiktok.com/@bp.asesorias.contables/video/7391289223623494918' },
];
---

<section class="section bg-bg">
	<div class="container-x flex flex-col items-center gap-8">
		<SectionHeader
			eyebrow="Redes Sociales"
			title="Contenido en <span class='text-brand-500'>TikTok</span>"
			subtitle="Síganos para recibir consejos prácticos sobre contabilidad y finanzas."
		/>

		<a href={SITE.tiktok} target="_blank" rel="noopener noreferrer"
			class="reveal inline-flex items-center gap-2 min-h-[44px] px-6 rounded-full bg-ink text-white text-sm font-semibold hover:bg-brand-900 transition-colors duration-300 shadow-soft">
			<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={tiktokPath} /></svg>
			@bp.asesorias.contables
		</a>

		<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 w-full pt-4">
			{videos.map((video, i) => (
				<article class="reveal bg-surface border border-border rounded-card overflow-hidden shadow-soft transition-all duration-300 hover:shadow-lift hover:-translate-y-1" data-reveal-delay={i * 120}>
					<div class="flex items-center gap-2.5 p-4 border-b border-border">
						<div class="w-8 h-8 rounded-full bg-ink grid place-items-center shrink-0">
							<svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={tiktokPath} /></svg>
						</div>
						<div class="min-w-0">
							<span class="block text-sm font-semibold text-ink leading-tight">@bp.asesorias.contables</span>
							<span class="block text-xs text-muted leading-snug line-clamp-1">{video.title}</span>
						</div>
					</div>
					<div class="p-3">
						<blockquote class="tiktok-embed !m-0" cite={video.cite} data-video-id={video.id} style="max-width:100%;min-width:280px;margin:0;">
							<section>
								<a target="_blank" rel="noopener noreferrer" title="@bp.asesorias.contables" href="https://www.tiktok.com/@bp.asesorias.contables?refer=embed">@bp.asesorias.contables</a>
							</section>
						</blockquote>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<script is:inline async src="https://www.tiktok.com/embed.js"></script>
