---
/**
 * Stat de anillo fino con count-up al entrar en viewport.
 * Reemplaza el conic-gradient pesado por un ring SVG elegante.
 */
interface Props { percentage: number; serviceName: string }
const { percentage, serviceName } = Astro.props;

const r = 42;
const circ = 2 * Math.PI * r;
---

<div class="flex flex-col items-center gap-3 text-center">
	<div class="stat-ring relative w-20 h-20 sm:w-24 sm:h-24" data-value={percentage} data-circ={circ.toFixed(2)}>
		<svg class="w-full h-full -rotate-90" viewBox="0 0 100 100" aria-hidden="true">
			<circle cx="50" cy="50" r={r} fill="none" stroke="#E1EED0" stroke-width="6" />
			<circle
				class="ring-progress"
				cx="50" cy="50" r={r} fill="none" stroke="#5A9E2F" stroke-width="6"
				stroke-linecap="round"
				stroke-dasharray={circ.toFixed(2)}
				stroke-dashoffset={circ.toFixed(2)}
				style="transition: stroke-dashoffset 1.4s cubic-bezier(0.22,1,0.36,1);"
			/>
		</svg>
		<span class="ring-number absolute inset-0 grid place-items-center font-serif font-semibold text-brand-700 text-lg sm:text-xl" aria-hidden="true">0%</span>
		<span class="sr-only">{percentage}%</span>
	</div>
	<span class="text-xs sm:text-sm font-medium text-muted max-w-[6rem] leading-tight">{serviceName}</span>
</div>

<script>
	import { CountUp } from 'countup.js';

	const rings = document.querySelectorAll<HTMLElement>('.stat-ring');
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function animate(el: HTMLElement) {
		const value = Number(el.dataset.value || 0);
		const circ = Number(el.dataset.circ || 0);
		const progress = el.querySelector<SVGCircleElement>('.ring-progress');
		const number = el.querySelector<HTMLElement>('.ring-number');
		if (progress) progress.style.strokeDashoffset = String(circ * (1 - value / 100));
		if (number) {
			if (reduce) { number.textContent = `${value}%`; return; }
			new CountUp(number, value, { suffix: '%', duration: 1.6 }).start();
		}
	}

	if (reduce || !('IntersectionObserver' in window)) {
		rings.forEach(animate);
	} else {
		const io = new IntersectionObserver((entries, obs) => {
			entries.forEach((e) => { if (e.isIntersecting) { animate(e.target as HTMLElement); obs.unobserve(e.target); } });
		}, { threshold: 0.5 });
		rings.forEach((el) => io.observe(el));
	}
</script>
