---
import { Icon } from 'astro-icon/components';
import WaIcon from './ui/WaIcon.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import type { BlogPost } from '../data/blog';
import { SITE, waLink } from '../data/site';

interface Props { post: BlogPost }

const { post } = Astro.props;

const words = post.content.split(/\s+/).length;
const readTime = Math.max(1, Math.round(words / 200));
---

<Breadcrumbs crumbs={[
  { label: 'Inicio', href: '/' },
  { label: 'Blog', href: '/blog/' },
  { label: post.title },
]} />

<article class="max-w-3xl mx-auto">
  <div class="flex flex-wrap items-center gap-3 mb-4">
    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-accent-soft text-brand-700 border border-brand-200">
      {post.category}
    </span>
    <span class="text-xs text-muted">{post.date}</span>
    <span class="text-xs text-muted flex items-center gap-1">
      <Icon name="lucide:clock" class="w-3 h-3" /> {readTime} min de lectura
    </span>
  </div>

  <h1 class="text-3xl md:text-4xl mb-4">{post.title}</h1>

  <div class="flex items-center gap-3 mb-8 pb-6 border-b border-border">
    <div class="w-10 h-10 rounded-full bg-brand-700 grid place-items-center text-white text-sm font-semibold">
      {post.author.split(' ').map(w => w[0]).join('').slice(0, 2)}
    </div>
    <div>
      <span class="block text-sm font-semibold text-ink">{post.author}</span>
      <span class="text-xs text-muted">{SITE.role}</span>
    </div>
  </div>

  <div class="prose prose-sm sm:prose-base max-w-none">
    {(() => {
      // Parser de markdown ligero: negritas/cursivas inline, encabezados, listas y tablas.
      const inline = (text: string) => {
        const nodes: (string | any)[] = [];
        const re = /\*\*(.+?)\*\*|\*(.+?)\*/g;
        let last = 0;
        let m;
        while ((m = re.exec(text))) {
          if (m.index > last) nodes.push(text.slice(last, m.index));
          if (m[1] !== undefined) nodes.push(<strong>{m[1]}</strong>);
          else nodes.push(<em>{m[2]}</em>);
          last = re.lastIndex;
        }
        if (last < text.length) nodes.push(text.slice(last));
        return nodes;
      };

      const lines = post.content.split('\n');
      const blocks: any[] = [];
      let i = 0;
      while (i < lines.length) {
        const line = lines[i];

        if (line.startsWith('## ')) {
          blocks.push(<h2 class="text-xl md:text-2xl mt-8 mb-4">{inline(line.replace('## ', ''))}</h2>);
          i++; continue;
        }
        if (line.startsWith('### ')) {
          blocks.push(<h3 class="text-lg mt-6 mb-3">{inline(line.replace('### ', ''))}</h3>);
          i++; continue;
        }
        if (line.startsWith('|')) {
          const tableLines: string[] = [];
          while (i < lines.length && lines[i].startsWith('|')) { tableLines.push(lines[i]); i++; }
          const rows = tableLines
            .filter((l) => !/^\|(\s*:?-+:?\s*\|)+$/.test(l))
            .map((l) => l.split('|').slice(1, -1).map((c) => c.trim()));
          const [head, ...body] = rows;
          blocks.push(
            <div class="overflow-x-auto my-5 rounded-xl border border-border">
              <table class="w-full text-sm border-collapse">
                <thead>
                  <tr class="bg-brand-50/60">
                    {head.map((h) => <th class="text-left px-4 py-2.5 font-semibold text-ink border-b border-border">{inline(h)}</th>)}
                  </tr>
                </thead>
                <tbody>
                  {body.map((row) => (
                    <tr class="border-b border-border last:border-0">
                      {row.map((c) => <td class="px-4 py-2.5 text-muted">{inline(c)}</td>)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          );
          continue;
        }
        if (line.startsWith('- ')) {
          blocks.push(
            <div class="flex items-start gap-2 mb-1">
              <span class="text-brand-500 mt-1.5 shrink-0">•</span>
              <p class="text-muted">{inline(line.replace('- ', ''))}</p>
            </div>
          );
          i++; continue;
        }
        if (line.match(/^\d+\. /)) {
          const num = line.match(/^(\d+)\. /)?.[1];
          blocks.push(
            <div class="flex items-start gap-2 mb-1 ml-4">
              <span class="text-brand-700 font-semibold shrink-0">{num}.</span>
              <p class="text-muted">{inline(line.replace(/^\d+\.\s*/, ''))}</p>
            </div>
          );
          i++; continue;
        }
        if (line.trim() === '') {
          blocks.push(<div class="h-3"></div>);
          i++; continue;
        }
        if (line.trim().startsWith('*') && line.trim().endsWith('*') && !line.trim().startsWith('**')) {
          blocks.push(<p class="text-muted text-xs italic mb-4">{line.trim().slice(1, -1)}</p>);
          i++; continue;
        }
        blocks.push(<p class="text-muted leading-relaxed mb-4">{inline(line)}</p>);
        i++;
      }
      return blocks;
    })()}
  </div>

  <div class="mt-10 pt-6 border-t border-border">
    <div class="bg-brand-50/60 rounded-card p-6 flex flex-col sm:flex-row items-center gap-4">
      <div class="text-center sm:text-left">
        <h3 class="text-base mb-1">¿Necesita ayuda con este tema?</h3>
        <p class="text-muted text-sm">Consulte a nuestro equipo de expertos sin compromiso.</p>
      </div>
      <a href={waLink(`Hola, vi el artículo "${post.title}" y me gustaría recibir asesoría.`)} target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-2 min-h-[44px] px-6 rounded-full bg-brand-500 text-white font-semibold text-sm shadow-soft hover:bg-brand-600 hover:shadow-lift hover:-translate-y-0.5 transition-all duration-300 shrink-0">
        <WaIcon class="w-4 h-4" /> Consultar ahora
      </a>
    </div>
  </div>
</article>
