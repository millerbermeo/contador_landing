---
/**
 * Encabezado de sección: eyebrow + titular serif + subtítulo.
 * - as: 'h1' en cabeceras de página, 'h2' (por defecto) en secciones.
 * - align: left | center
 * - El título acepta HTML (para <span class="mark">).
 */
import Badge from './Badge.astro';

interface Props {
	eyebrow?: string;
	title: string;
	subtitle?: string;
	align?: 'left' | 'center';
	as?: 'h1' | 'h2';
	id?: string;
	class?: string;
}

const { eyebrow, title, subtitle, align = 'center', as = 'h2', id, class: cls = '' } = Astro.props;
const Heading = as;
const alignCls = align === 'center' ? 'items-center text-center mx-auto' : 'items-start text-left';
---

<div class={`reveal flex max-w-2xl flex-col gap-4 ${alignCls} ${cls}`}>
	{eyebrow && <Badge variant="eyebrow">{eyebrow}</Badge>}
	<Heading id={id} class={as === 'h1' ? 'text-h1' : ''} set:html={title} />
	{subtitle && <p class="lead max-w-[60ch]">{subtitle}</p>}
</div>
