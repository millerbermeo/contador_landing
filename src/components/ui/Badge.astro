---
/**
 * Etiqueta del sistema de diseño.
 * - eyebrow: label uppercase verde con punto lima (encabezado de sección)
 * - soft: pill lima suave con texto verde (AA)
 * - solid: pill verde bosque sólido
 * - neutral: pill blanca con borde
 */
interface Props {
	variant?: 'eyebrow' | 'soft' | 'solid' | 'neutral';
	class?: string;
}

const { variant = 'soft', class: cls = '' } = Astro.props;

const styles: Record<string, string> = {
	eyebrow: 'eyebrow',
	soft: 'chip-brand',
	solid: 'inline-flex items-center gap-1.5 rounded-full bg-brand-700 px-3 py-1 text-xs font-semibold text-white',
	neutral: 'chip',
};
---

<span class={`${styles[variant]} ${cls}`}>
	{variant === 'eyebrow' && <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />}
	<slot />
</span>
