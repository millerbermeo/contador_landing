---
/**
 * Tarjeta base: superficie blanca, borde hairline, radio `card` y sombra por capas.
 * - hover: elevación sutil (translateY + sombra lift), solo si es interactiva.
 */
interface Props {
	class?: string;
	hover?: boolean;
	as?: string;
	[key: string]: any;
}

const { class: cls = '', hover = false, as = 'div', ...rest } = Astro.props;
const Tag = as as any;
---

<Tag class={`card ${hover ? 'card-interactive' : ''} ${cls}`} {...rest}>
	<slot />
</Tag>
