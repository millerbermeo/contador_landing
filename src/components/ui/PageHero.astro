---
/**
 * Cabecera de página interior: breadcrumbs + eyebrow + H1 + lead + acciones.
 * Fondo con aurora suave para dar continuidad visual con el hero de la home.
 * Slot opcional "aside": panel a la derecha en escritorio (datos de apoyo),
 * debajo del texto en móvil.
 */
import Breadcrumbs from '../Breadcrumbs.astro';
import Badge from './Badge.astro';
import { Icon } from 'astro-icon/components';

interface Props {
	title: string;
	eyebrow?: string;
	lead?: string;
	crumbs?: { label: string; href?: string }[];
	icon?: string;
	align?: 'left' | 'center';
	/** Muestra el slot "aside" también en móvil/tablet (por defecto solo desde lg). */
	asideMobile?: boolean;
	class?: string;
}

const { title, eyebrow, lead, crumbs, icon, align = 'left', asideMobile = false, class: cls = '' } = Astro.props;
const center = align === 'center';
const hasAside = Astro.slots.has('aside');
---

<section class={`relative isolate overflow-hidden border-b border-border ${cls}`}>
	<div class="bg-aurora pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
	<div class="bg-dots pointer-events-none absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>
	<div class="container-x pb-14 pt-8 sm:pb-20 sm:pt-10">
		{crumbs && <Breadcrumbs crumbs={crumbs} />}
		<div class={hasAside ? 'mt-8 grid items-end gap-10 sm:mt-12 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-16 xl:grid-cols-[minmax(0,1fr)_24rem]' : ''}>
		<div class={`${hasAside ? '' : 'mt-8 sm:mt-12'} flex max-w-3xl flex-col gap-5 ${center && !hasAside ? 'mx-auto items-center text-center' : ''}`}>
			{icon && (
				<span class="icon-tile reveal h-14 w-14 rounded-2xl shadow-xs">
					<Icon name={icon} class="h-7 w-7" aria-hidden="true" />
				</span>
			)}
			{eyebrow && <Badge variant="eyebrow" class="reveal">{eyebrow}</Badge>}
			<h1 class="reveal" data-reveal-delay="60" set:html={title} />
			{lead && <p class="lead reveal max-w-[60ch]" data-reveal-delay="120">{lead}</p>}
			{
				Astro.slots.has('default') && (
					<div class={`reveal mt-2 flex flex-col gap-3 sm:flex-row sm:flex-wrap [&>*]:w-full sm:[&>*]:w-auto ${center ? 'sm:justify-center' : ''}`} data-reveal-delay="180">
						<slot />
					</div>
				)
			}
		</div>
		{hasAside && (
			<div class={`reveal min-w-0 ${asideMobile ? '' : 'hidden lg:block'}`} data-reveal-delay="200">
				<slot name="aside" />
			</div>
		)}
		</div>
	</div>
</section>
