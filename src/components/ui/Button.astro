---
/**
 * Botón / enlace del sistema de diseño.
 * - <a> si recibe `href`; si no, <button>.
 * - Variantes: primary | secondary | ghost | inverse | outline-inverse
 *   (alias heredados: outline → secondary, whatsapp → primary).
 * - Tamaños: sm | md | lg. Área táctil mínima 44px.
 * - Estados: hover, :active scale(.97) instantáneo, focus-visible y disabled (ver global.css).
 */
interface Props {
	variant?: 'primary' | 'secondary' | 'ghost' | 'inverse' | 'outline-inverse' | 'outline' | 'whatsapp';
	size?: 'sm' | 'md' | 'lg';
	href?: string;
	type?: 'button' | 'submit';
	block?: boolean;
	disabled?: boolean;
	class?: string;
	[key: string]: any;
}

const {
	variant = 'primary',
	size = 'md',
	href,
	type = 'button',
	block = false,
	disabled = false,
	class: cls = '',
	...rest
} = Astro.props;

const alias: Record<string, string> = { outline: 'secondary', whatsapp: 'primary' };
const v = alias[variant] ?? variant;
const sizeCls = size === 'lg' ? 'btn-lg' : size === 'sm' ? 'btn-sm' : '';
const classes = ['btn', `btn-${v}`, sizeCls, block && 'btn-block', cls].filter(Boolean).join(' ');
const isExternal = href?.startsWith('http');
---

{
	href ? (
		<a
			href={disabled ? undefined : href}
			class={classes}
			aria-disabled={disabled ? 'true' : undefined}
			{...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
			{...rest}
		>
			<slot />
		</a>
	) : (
		<button type={type} class={classes} disabled={disabled} {...rest}>
			<slot />
		</button>
	)
}
