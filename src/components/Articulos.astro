---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SectionHeader from './ui/SectionHeader.astro';
import art1 from '../assets/contaduria-1.jpg';
import art2 from '../assets/contaduria-2.jpg';
import art3 from '../assets/contaduria-3.jpg';
import art4 from '../assets/contaduria-4.jpg';

const articles = [
	{
		title: 'Suscripción Gratuita a Actualícese',
		link: 'https://actualicese.com/suscripcion-gratuita/',
		description: 'Obtén acceso a información contable y fiscal actualizada de Colombia.',
		image: art1,
		category: 'Recursos',
	},
	{
		title: 'Leyes con Contenido Tributario y Contable',
		link: 'https://www.ambitojuridico.com/noticias/blog-contable-yo-tributario/tributario-y-contable/leyes-con-contenido-tributario-y',
		description: 'Descubra las leyes recientes que impactan el ámbito tributario.',
		image: art2,
		category: 'Legislación',
	},
	{
		title: 'Guía Tributaria 2024 para Fiscales y Contables en Colombia',
		link: 'https://jlcauditors.com/guia-tributaria-2024-fiscales-contables-colombia/',
		description: 'Una guía completa sobre obligaciones fiscales para el año 2024.',
		image: art3,
		category: 'Guía',
	},
	{
		title: 'Comunidad Contable',
		link: 'https://www.comunidadcontable.com/home.asp',
		description: 'Recursos y herramientas para contadores en Colombia.',
		image: art4,
		category: 'Comunidad',
	},
];
---

<section class="section bg-brand-50/40">
	<div class="container-x flex flex-col items-center gap-14">
		<SectionHeader
			eyebrow="Recursos"
			title="Artículos de Interés"
			subtitle="Información actualizada sobre contabilidad, fiscalidad y normativas en Colombia."
		/>

		<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 w-full">
			{articles.map((a, i) => (
				<a
					href={a.link}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={`Leer artículo: ${a.title}`}
					class="reveal group bg-surface rounded-card overflow-hidden border border-border shadow-soft flex flex-col transition-all duration-300 hover:-translate-y-1 hover:shadow-lift hover:border-accent"
					data-reveal-delay={i * 100}
				>
					<div class="relative aspect-[16/10] overflow-hidden">
						<Image src={a.image} alt={a.title} width={440} height={275} loading="lazy"
							class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
						<div class="absolute inset-0 bg-gradient-to-t from-brand-900/50 to-transparent"></div>
						<span class="absolute top-3 left-3 bg-brand-700/90 backdrop-blur-sm text-white text-xs font-semibold px-3 py-1 rounded-full">{a.category}</span>
					</div>
					<div class="p-5 flex flex-col flex-1">
						<h3 class="text-base leading-snug mb-2 line-clamp-2 group-hover:text-brand-500 transition-colors">{a.title}</h3>
						<p class="text-muted text-sm leading-relaxed flex-1">{a.description}</p>
						<div class="flex items-center gap-1.5 mt-4 text-brand-500 text-sm font-semibold">
							Leer más
							<Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
						</div>
					</div>
				</a>
			))}
		</div>
	</div>
</section>
