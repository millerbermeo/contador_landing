---
import { Image } from 'astro:assets';
import qrImg from '../assets/qr.jpeg';
interface Props { class?: string }
const { class: cls = 'w-24 lg:w-32 rounded-xl' } = Astro.props;
---
<Image class={cls} src={qrImg} width={160} height={160} format="webp" quality={95} alt="Código QR de contacto de BP Asesorías Contables" loading="lazy" />
