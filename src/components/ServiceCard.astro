---
import { Icon } from 'astro-icon/components';
import WaIcon from './ui/WaIcon.astro';
import { waLink } from '../data/site';

export interface ServiceProps {
  icon: string;
  title: string;
  items: string[];
  whatsappMessage: string;
  href?: string;
  delay?: number;
}

const { icon, title, items, whatsappMessage, href, delay = 0 } = Astro.props;
---

<article class="card card-interactive reveal group flex flex-col p-6 sm:p-7" data-reveal-delay={delay}>
  <span class="icon-tile h-12 w-12">
    <Icon name={icon} class="h-6 w-6" aria-hidden="true" />
  </span>

  <h3 class="mt-6">{title}</h3>

  <ul class="mt-4 flex-1 space-y-2.5" role="list">
    {items.map((item) => (
      <li class="flex items-start gap-2.5 text-[0.9375rem] leading-relaxed text-ink-soft">
        <Icon name="lucide:check" class="mt-1 h-4 w-4 text-brand-600" aria-hidden="true" />
        <span>{item}</span>
      </li>
    ))}
  </ul>

  <div class="mt-7 flex flex-col gap-2 border-t border-border pt-5">
    <a href={waLink(whatsappMessage)} target="_blank" rel="noopener noreferrer"
      aria-label={`Solicitar por WhatsApp: ${title}`} class="btn btn-primary btn-block">
      <WaIcon class="h-4 w-4" /> Solicitar por WhatsApp
    </a>
    {href && (
      <a href={href} class="btn btn-ghost btn-block" aria-label={`Ver más servicios para ${title}`}>
        Ver más <Icon name="lucide:arrow-right" class="arrow h-4 w-4" aria-hidden="true" />
      </a>
    )}
  </div>
</article>
