---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SectionHeader from './ui/SectionHeader.astro';
import { SITE, waLink } from '../data/site';
import brianImg from '../assets/brian.jpeg';

const author = {
	name: SITE.fullName,
	title: SITE.role,
	university: SITE.university,
	description: `Soy Brian Pedraza Osorio, Contador Público. Acompaño a empresarios, emprendedores y personas naturales en la organización de su información contable y el cumplimiento de sus obligaciones tributarias. Mi objetivo es que puedas entender mejor tus números y tomar decisiones con información clara y confiable.`,
	imageSrc: 'brian.jpeg',
};

const credentials = [
	{ icon: 'lucide:badge-check', label: 'Tarjeta Profesional Vigente' },
	{ icon: 'lucide:shield-check', label: 'Contador Certificado' },
];

const facts = [
	{ icon: 'lucide:map-pin', label: 'Ubicación', value: SITE.location },
	{ icon: 'lucide:clock', label: 'Experiencia', value: '+5 años' },
	{ icon: 'lucide:graduation-cap', label: 'Formación', value: 'Univ. de la Amazonia' },
	{ icon: 'lucide:badge-check', label: 'Registro', value: 'DIAN Certificado' },
];
---

<section id="nosotros" class="section section-tint">
	<div class="container-x flex flex-col items-center gap-12 sm:gap-16">
		<SectionHeader
			eyebrow="Sobre el profesional"
			title="El profesional detrás de BP Asesorías Contables"
			subtitle="Un profesional comprometido con la transparencia y el crecimiento de su empresa."
		/>

		<div class="reveal card w-full max-w-5xl overflow-hidden rounded-panel p-3 sm:p-4">
			<div class="grid gap-6 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] md:gap-4">

				<!-- Foto (fondo blanco fundido con el degradado de marca) -->
				<figure class="relative overflow-hidden rounded-[1.25rem] bg-gradient-to-b from-brand-50 to-brand-200/70">
					<Image src={brianImg} alt={`Foto de ${author.name}, Contador Público`} width={560} height={600}
						widths={[360, 560]} sizes="(min-width: 768px) 26rem, 92vw" format="webp" loading="lazy"
						class="aspect-[4/4.3] h-full w-full object-cover object-top mix-blend-multiply md:aspect-auto" />
					<figcaption class="absolute inset-x-3 bottom-3 rounded-2xl bg-brand-950/85 p-4 text-white backdrop-blur-md">
						<p class="font-serif text-lg font-semibold leading-tight">{author.name}</p>
						<p class="mt-0.5 text-sm text-brand-200">{author.university}</p>
						<ul class="mt-3 flex flex-wrap gap-1.5" role="list">
							{credentials.map((c) => (
								<li class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-2.5 py-1 text-2xs font-medium text-white ring-1 ring-inset ring-white/15">
									<Icon name={c.icon} class="h-3.5 w-3.5 text-accent" aria-hidden="true" /> {c.label}
								</li>
							))}
						</ul>
					</figcaption>
				</figure>

				<!-- Bio -->
				<div class="flex flex-col justify-center gap-7 px-3 pb-5 sm:px-6 md:py-8 md:pr-8 lg:px-10">
					<div>
						<span class="eyebrow">Sobre mí</span>
						<h3 class="mt-3 text-h2">
							{author.name}
							<span class="mt-2 block font-sans text-base font-medium tracking-normal text-brand-700">{author.title}</span>
						</h3>
					</div>

					<p class="text-[1.0625rem] leading-relaxed text-ink-soft">{author.description}</p>

					<dl class="grid grid-cols-2 gap-x-4 gap-y-5 border-y border-border py-6">
						{facts.map((f) => (
							<div class="flex items-center gap-3">
								<span class="icon-tile h-10 w-10 rounded-lg"><Icon name={f.icon} class="h-[1.125rem] w-[1.125rem]" aria-hidden="true" /></span>
								<div class="min-w-0">
									<dt class="text-2xs font-semibold uppercase tracking-[0.1em] text-muted">{f.label}</dt>
									<dd class="text-sm font-semibold text-ink">{f.value}</dd>
								</div>
							</div>
						))}
					</dl>

					<div class="flex flex-col items-start gap-4">
						<a href={waLink('Hola Brian, me gustaría hablar sobre asesoría contable.')} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
							Hablar con Brian <Icon name="lucide:arrow-right" class="arrow h-4 w-4" aria-hidden="true" />
						</a>
						<p class="text-sm text-muted">
							Atención en <a href="/florencia-caqueta/" class="link">Florencia, Caquetá</a> y de forma remota en <a href="/contador-en-huila/" class="link">el Huila</a>.
						</p>
					</div>
				</div>

			</div>
		</div>
	</div>
</section>
