---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SectionHeader from './ui/SectionHeader.astro';
import { SITE, waLink } from '../data/site';
import brianImg from '../assets/brian.jpeg';

const author = {
	name: SITE.fullName,
	title: SITE.role,
	university: SITE.university,
	description: `Soy Brian Pedraza Osorio, Contador Público. Acompaño a empresarios, emprendedores y personas naturales en la organización de su información contable y el cumplimiento de sus obligaciones tributarias. Mi objetivo es que puedas entender mejor tus números y tomar decisiones con información clara y confiable.`,
	imageSrc: 'brian.jpeg',
};

const credentials = [
	{ icon: 'lucide:badge-check', label: 'Tarjeta Profesional Vigente' },
	{ icon: 'lucide:shield-check', label: 'Contador Certificado' },
];

const facts = [
	{ icon: 'lucide:map-pin', label: 'Ubicación', value: SITE.location },
	{ icon: 'lucide:clock', label: 'Experiencia', value: '+5 años' },
	{ icon: 'lucide:graduation-cap', label: 'Formación', value: 'Univ. de la Amazonia' },
	{ icon: 'lucide:badge-check', label: 'Registro', value: 'DIAN Certificado' },
];
---

<section id="nosotros" class="section bg-bg scroll-mt-20">
	<div class="container-x flex flex-col items-center gap-14">
		<SectionHeader
			eyebrow="Sobre el profesional"
			title="El profesional detrás de BP Asesorías Contables"
			subtitle="Un profesional comprometido con la transparencia y el crecimiento de su empresa."
		/>

		<div class="reveal w-full max-w-5xl bg-surface rounded-card shadow-soft border border-border overflow-hidden">
			<div class="grid lg:grid-cols-5">

				<!-- Panel foto (gradiente oscuro) -->
				<div class="lg:col-span-2 relative bg-brand-dark flex flex-col items-center justify-center gap-6 p-10 lg:p-12 text-center overflow-hidden">
					<div class="absolute inset-0 grid-bg opacity-[0.06] pointer-events-none" aria-hidden="true"></div>
					<div class="relative">
						<div class="absolute inset-0 rounded-full bg-accent/25 blur-2xl scale-110" aria-hidden="true"></div>
						<Image src={brianImg} alt={`Foto de ${author.name}, Contador Público`} width={352} height={352} format="webp" loading="lazy"
							class="relative w-40 h-40 lg:w-44 lg:h-44 rounded-full object-cover border-4 border-surface ring-2 ring-accent shadow-lift" />
					</div>
					<div class="relative">
						<h3 class="text-white text-xl">{author.name}</h3>
						<p class="text-accent/90 text-sm mt-1">{author.university}</p>
					</div>
					<div class="relative flex flex-wrap gap-2 justify-center">
						{credentials.map((c) => (
							<span class="inline-flex items-center gap-1.5 bg-white/10 border border-white/20 text-white text-xs font-medium px-3 py-1.5 rounded-full">
								<Icon name={c.icon} class="w-3.5 h-3.5 text-accent" /> {c.label}
							</span>
						))}
					</div>
				</div>

				<!-- Panel bio -->
				<div class="lg:col-span-3 p-8 sm:p-10 lg:p-12 flex flex-col justify-center gap-6">
					<div>
						<span class="eyebrow">Sobre mí</span>
						<h3 class="mt-2 text-2xl lg:text-3xl leading-tight">
							{author.name}
							<span class="block font-sans text-base font-normal text-brand-500 mt-1">{author.title}</span>
						</h3>
					</div>

					<p class="text-muted text-base leading-relaxed">{author.description}</p>

					<div class="grid sm:grid-cols-2 gap-4 pt-1">
						{facts.map((f) => (
							<div class="flex items-center gap-3">
								<div class="w-10 h-10 rounded-xl bg-accent-soft grid place-items-center shrink-0">
									<Icon name={f.icon} class="w-5 h-5 text-brand-500" />
								</div>
								<div>
									<span class="text-[0.7rem] text-muted font-medium uppercase tracking-wide block">{f.label}</span>
									<span class="text-sm text-ink font-semibold">{f.value}</span>
								</div>
							</div>
						))}
					</div>

					<div class="pt-1">
						<a href={waLink('Hola Brian, me gustaría hablar sobre asesoría contable.')} target="_blank" rel="noopener noreferrer"
							class="inline-flex items-center gap-2 min-h-[44px] px-6 rounded-full bg-brand-500 text-white font-semibold text-sm shadow-soft hover:bg-brand-600 hover:shadow-lift hover:-translate-y-0.5 transition-all duration-300">
							Hablar con Brian <Icon name="lucide:arrow-right" class="w-4 h-4" />
						</a>
					</div>
				</div>

			</div>
		</div>
	</div>
</section>
