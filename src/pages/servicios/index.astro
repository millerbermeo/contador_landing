---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Whatsapp from '../../components/Whatsapp.astro';
import Footer from '../../components/Footer.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { Icon } from 'astro-icon/components';
import { services } from '../../data/services';
import { waLink } from '../../data/site';
---

<Layout
  title="Servicios Contables y Fiscales"
  description="Conozca todos nuestros servicios contables en Colombia: asesorías contables, declaración de renta, facturación electrónica, creación de empresas, nómina y consultoría tributaria."
>
  <Navbar activePath="/servicios/" />
  <Whatsapp />

  <main id="contenido" tabindex="-1" class="focus:outline-none">
    <PageHero
      eyebrow="Portafolio"
      title="Servicios Profesionales"
      lead="Soluciones contables y fiscales diseñadas para impulsar el crecimiento de su empresa y garantizar el cumplimiento normativo."
      crumbs={[
        { label: 'Inicio', href: '/' },
        { label: 'Servicios' },
      ]}
    />

    <section class="section" aria-label="Listado de servicios">
      <div class="container-x">
        <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3 lg:gap-6" role="list" data-stagger>
          {services.map((s) => (
            <li class="reveal">
              <article class="card card-interactive group relative flex h-full flex-col p-7">
                <span class="icon-tile mb-6">
                  <Icon name={s.icon} class="h-6 w-6" aria-hidden="true" />
                </span>
                <h2 class="text-h4 font-sans font-semibold leading-snug">
                  <a href={`/servicios/${s.slug}/`} class="stretched-link">{s.title}</a>
                </h2>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{s.description}</p>
                <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700" aria-hidden="true">
                  Ver servicio <Icon name="lucide:arrow-right" class="arrow h-4 w-4" />
                </span>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section-tight">
      <div class="container-x">
        <div class="reveal card mx-auto flex max-w-3xl flex-col items-center gap-5 bg-sunken p-8 text-center shadow-none sm:p-10">
          <h2 class="text-h3">¿No encuentra el servicio que busca?</h2>
          <p class="max-w-md text-muted">Contáctenos y creamos un paquete personalizado para su empresa.</p>
          <a href={waLink('Hola, quiero un servicio personalizado.')} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            Solicitar cotización personalizada
          </a>
        </div>
      </div>
    </section>

    <CtaFinal />
  </main>

  <Footer />
</Layout>
