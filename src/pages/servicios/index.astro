---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Whatsapp from '../../components/Whatsapp.astro';
import Footer from '../../components/Footer.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { Icon } from 'astro-icon/components';
import { services } from '../../data/services';
import { waLink } from '../../data/site';

const audiences = [
  { icon: 'lucide:building-2', label: 'Empresas' },
  { icon: 'lucide:rocket', label: 'Emprendedores' },
  { icon: 'lucide:user-check', label: 'Personas naturales' },
];
---

<Layout
  title="Servicios Contables y Fiscales"
  description="Conozca todos nuestros servicios contables en Colombia: asesorías contables, declaración de renta, facturación electrónica, creación de empresas, nómina y consultoría tributaria."
>
  <Navbar activePath="/servicios/" />
  <Whatsapp />

  <main id="contenido" tabindex="-1" class="focus:outline-none">
    <PageHero
      eyebrow="Portafolio"
      title="Servicios Profesionales"
      lead="Soluciones contables y fiscales diseñadas para impulsar el crecimiento de su empresa y garantizar el cumplimiento normativo."
      crumbs={[
        { label: 'Inicio', href: '/' },
        { label: 'Servicios' },
      ]}
    >
      <div slot="aside" class="card p-6 sm:p-7">
        <p class="flex items-baseline gap-3">
          <span class="font-serif text-5xl font-medium leading-none tracking-tight text-ink">{services.length}</span>
          <span class="text-sm font-medium text-muted">servicios especializados</span>
        </p>
        <ul class="mt-6 divide-y divide-border border-t border-border" role="list">
          {audiences.map((a) => (
            <li class="flex min-h-[48px] items-center gap-3 py-2.5 text-sm font-medium text-ink">
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-accent-soft text-brand-700">
                <Icon name={a.icon} class="h-4 w-4" aria-hidden="true" />
              </span>
              {a.label}
            </li>
          ))}
        </ul>
      </div>
    </PageHero>

    <section class="section" aria-label="Listado de servicios">
      <div class="container-x">
        <ul class="grid gap-5 md:grid-cols-2 lg:gap-6 xl:grid-cols-4" role="list" data-stagger>
          {services.map((s) => (
            <li class="reveal">
              <article class="card card-interactive group relative flex h-full flex-col p-6 sm:p-7">
                <span class="icon-tile mb-6">
                  <Icon name={s.icon} class="h-6 w-6" aria-hidden="true" />
                </span>
                <h2 class="text-h4 font-sans font-semibold leading-snug">
                  <a href={`/servicios/${s.slug}/`} class="stretched-link">{s.title}</a>
                </h2>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{s.description}</p>
                <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700" aria-hidden="true">
                  Ver servicio <Icon name="lucide:arrow-right" class="arrow h-4 w-4" />
                </span>
              </article>
            </li>
          ))}
        </ul>

        <p class="reveal mt-10 flex flex-col items-start gap-x-4 gap-y-2 border-t border-border pt-8 text-muted sm:flex-row sm:items-center sm:justify-center">
          <span>¿No encuentra el servicio que busca? Contáctenos y creamos un paquete personalizado para su empresa.</span>
          <a href={waLink('Hola, quiero un servicio personalizado.')} target="_blank" rel="noopener noreferrer" class="link inline-flex min-h-[44px] items-center gap-1.5 font-semibold">
            Solicitar cotización personalizada <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
          </a>
        </p>
      </div>
    </section>

    <CtaFinal />
  </main>

  <Footer />
</Layout>
