---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Whatsapp from '../../components/Whatsapp.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import { Icon } from 'astro-icon/components';
import { services } from '../../data/services';
import { waLink } from '../../data/site';
---

<Layout
  title="Servicios Contables y Fiscales"
  description="Conozca todos nuestros servicios contables en Colombia: asesorías contables, declaración de renta, facturación electrónica, creación de empresas, nómina y consultoría tributaria."
>
  <Navbar activePath="/servicios/" />
  <Whatsapp />

  <main>
    <div class="container-x pt-8 pb-4">
      <Breadcrumbs crumbs={[
        { label: 'Inicio', href: '/' },
        { label: 'Servicios' },
      ]} />
    </div>

    <section class="section pt-0">
      <div class="container-x">
        <SectionHeader
          eyebrow="Portafolio"
          title="Servicios Profesionales"
          subtitle="Soluciones contables y fiscales diseñadas para impulsar el crecimiento de su empresa y garantizar el cumplimiento normativo."
        />

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
          {services.map((s, i) => (
            <a href={`/servicios/${s.slug}/`}
              class="reveal group bg-surface rounded-card border border-border shadow-soft p-7 flex flex-col transition-all duration-300 hover:-translate-y-1 hover:shadow-lift hover:border-accent"
              data-reveal-delay={(i % 3) * 100}>
              <div class="w-12 h-12 rounded-xl bg-accent-soft grid place-items-center mb-5 group-hover:bg-brand-500 transition-colors duration-300">
                <Icon name={s.icon} class="w-6 h-6 text-brand-500 group-hover:text-white transition-colors duration-300" />
              </div>
              <h2 class="text-lg leading-tight mb-3">{s.title}</h2>
              <p class="text-muted text-sm leading-relaxed flex-1 mb-4">{s.description}</p>
              <span class="inline-flex items-center gap-1 text-brand-500 text-sm font-semibold group-hover:gap-2 transition-all">
                Ver servicio <Icon name="lucide:arrow-right" class="w-4 h-4" />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section bg-brand-50/40">
      <div class="container-x text-center">
        <div class="max-w-xl mx-auto">
          <h2 class="text-2xl mb-3">¿No encuentra el servicio que busca?</h2>
          <p class="text-muted mb-6">Contáctenos y creamos un paquete personalizado para su empresa.</p>
          <a href={waLink('Hola, quiero un servicio personalizado.')} target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 min-h-[44px] px-6 rounded-full bg-brand-500 text-white font-semibold text-sm shadow-soft hover:bg-brand-600 hover:shadow-lift hover:-translate-y-0.5 transition-all duration-300">
            Solicitar cotización personalizada
          </a>
        </div>
      </div>
    </section>

    <CtaFinal />
  </main>

  <Footer />
</Layout>
