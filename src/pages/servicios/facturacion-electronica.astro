---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Whatsapp from '../../components/Whatsapp.astro';
import Footer from '../../components/Footer.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { services } from '../../data/services';
import { serviceSchema } from '../../data/schema';

const service = services.find((s) => s.slug === 'facturacion-electronica')!;
---

<Layout
  title={service.title}
  description={service.metaDescription}
  schema={serviceSchema(service)}
>
  <Navbar activePath="/servicios/facturacion-electronica/" />
  <Whatsapp />

  <main>
    <div class="container-x pt-8 pb-4">
      <ServiceDetail service={service} />
    </div>
    <CtaFinal />
  </main>

  <Footer />
</Layout>
