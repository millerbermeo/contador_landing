---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Whatsapp from '../../components/Whatsapp.astro';
import Footer from '../../components/Footer.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { services } from '../../data/services';
import { serviceSchema } from '../../data/schema';

const service = services.find((s) => s.slug === 'declaracion-renta')!;
---

<Layout
  title={service.title}
  description={service.metaDescription}
  schema={serviceSchema(service)}
>
  <Navbar activePath="/servicios/declaracion-renta/" />
  <Whatsapp />

  <main id="contenido" tabindex="-1" class="focus:outline-none">
    <ServiceDetail service={service} />
    <CtaFinal />
  </main>

  <Footer />
</Layout>
