---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Whatsapp from '../components/Whatsapp.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';
import { HEADER_LINKS } from '../data/site';
---

<Layout
  title="Página no encontrada"
  description="La página que busca no existe o fue movida. Explore nuestros servicios contables y tributarios en Colombia."
  includeOrgSchema={false}
  noindex
>
  <Navbar />
  <Whatsapp />

  <main>
    <section class="section">
      <div class="container-x">
        <div class="max-w-lg mx-auto text-center flex flex-col items-center gap-6">
          <div class="w-16 h-16 rounded-2xl bg-accent-soft grid place-items-center">
            <Icon name="lucide:search-x" class="w-8 h-8 text-brand-500" />
          </div>
          <div>
            <span class="eyebrow block mb-2">Error 404</span>
            <h1 class="text-3xl md:text-4xl mb-3">Página no encontrada</h1>
            <p class="text-muted leading-relaxed">
              La página que busca no existe o fue movida. Puede volver al inicio o explorar nuestros servicios contables y tributarios.
            </p>
          </div>

          <div class="flex flex-wrap justify-center gap-3">
            <a href="/"
              class="inline-flex items-center gap-2 min-h-[44px] px-6 rounded-full bg-brand-500 text-white font-semibold text-sm shadow-soft hover:bg-brand-600 hover:shadow-lift hover:-translate-y-0.5 transition-all duration-300">
              <Icon name="lucide:home" class="w-4 h-4" /> Ir al inicio
            </a>
            <a href="/servicios/"
              class="inline-flex items-center gap-2 min-h-[44px] px-6 rounded-full border border-brand-500 text-brand-700 font-semibold text-sm hover:bg-brand-500 hover:text-white hover:-translate-y-0.5 transition-all duration-300">
              Ver servicios
            </a>
          </div>

          <nav aria-label="Enlaces principales" class="w-full pt-6 border-t border-border">
            <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
              {HEADER_LINKS.map((link) => (
                <li><a href={link.href} class="text-muted hover:text-brand-700 transition-colors">{link.label}</a></li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
