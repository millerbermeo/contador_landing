---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Whatsapp from '../components/Whatsapp.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';
import { HEADER_LINKS } from '../data/site';
import { services } from '../data/services';
---

<Layout
  title="Página no encontrada"
  description="La página que busca no existe o fue movida. Explore nuestros servicios contables y tributarios en Colombia."
  includeOrgSchema={false}
  noindex
>
  <Navbar />
  <Whatsapp />

  <main id="contenido" tabindex="-1" class="focus:outline-none">
    <section class="relative isolate overflow-hidden">
      <div class="bg-aurora pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="bg-dots pointer-events-none absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>
      <div class="container-x py-20 sm:py-28">
        <div class="mx-auto flex max-w-lg flex-col items-center gap-6 text-center">
          <span class="icon-tile h-16 w-16"><Icon name="lucide:search-x" class="h-8 w-8" aria-hidden="true" /></span>
          <div>
            <span class="eyebrow">Error 404</span>
            <h1 class="mt-4">Página no encontrada</h1>
            <p class="lead mt-4">
              La página que busca no existe o fue movida. Puede volver al inicio o explorar nuestros servicios contables y tributarios.
            </p>
          </div>

          <div class="flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row">
            <a href="/" class="btn btn-primary">
              <Icon name="lucide:home" class="h-4 w-4" aria-hidden="true" /> Ir al inicio
            </a>
            <a href="/servicios/" class="btn btn-secondary">Ver servicios</a>
          </div>

        </div>

        <div class="mx-auto mt-16 max-w-4xl">
          <h2 class="text-center font-sans text-sm font-semibold text-ink">¿Buscaba alguno de estos servicios?</h2>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" role="list">
            {services.map((s) => (
              <li>
                <a href={`/servicios/${s.slug}/`} class="card card-interactive group flex min-h-[56px] items-center gap-3 p-3 pr-4 text-sm font-medium text-ink">
                  <span class="icon-tile h-9 w-9 shrink-0 rounded-xl"><Icon name={s.icon} class="h-4 w-4" aria-hidden="true" /></span>
                  <span class="flex-1">{s.shortTitle}</span>
                  <Icon name="lucide:arrow-right" class="arrow h-4 w-4 text-muted" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>

          <nav aria-label="Enlaces principales" class="mt-10 border-t border-border pt-6">
            <ul class="flex flex-wrap justify-center gap-x-2 gap-y-1 text-sm" role="list">
              {HEADER_LINKS.map((link) => (
                <li><a href={link.href} class="btn btn-ghost btn-sm">{link.label}</a></li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
