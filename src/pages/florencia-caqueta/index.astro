---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Whatsapp from '../../components/Whatsapp.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Accordion from '../../components/ui/Accordion.astro';
import WaIcon from '../../components/ui/WaIcon.astro';
import { Icon } from 'astro-icon/components';
import { SITE, waLink } from '../../data/site';
import { serviceSchema, faqSchema } from '../../data/schema';
import { services } from '../../data/services';

const localServices = services.filter((s) =>
  ['asesorias-contables', 'declaracion-renta', 'facturacion-electronica', 'creacion-empresas', 'contabilidad-personas', 'consultoria-tributaria'].includes(s.slug)
);

const faqs = [
  { q: '¿Atienden de forma presencial en Florencia?', a: 'Sí. Además de la asesoría por WhatsApp y correo, puede agendar una cita presencial en Florencia para revisar su caso con calma, especialmente para trámites de constitución de empresa o auditorías.' },
  { q: '¿Dónde queda la Cámara de Comercio para registrar mi empresa en Florencia?', a: 'El registro mercantil se realiza ante la Cámara de Comercio de Florencia para el Caquetá. La acompañamos en todo el proceso: elección del tipo societario, documentos, registro y obtención del RUT.' },
  { q: '¿Manejan declaración de renta para personas de Florencia y el Caquetá?', a: 'Sí, es uno de nuestros servicios principales. Revisamos su situación, identificamos deducciones aplicables y presentamos la declaración ante la DIAN dentro de los plazos.' },
  { q: '¿Trabajan con negocios del sector agropecuario y comercial del Caquetá?', a: 'Sí. Buena parte de nuestros clientes en la región son comerciantes, transportadores, ganaderos e independientes que necesitan contabilidad clara y cumplimiento tributario sin complicaciones.' },
  { q: '¿Cómo empiezo si nunca he llevado mi contabilidad al día?', a: 'Hacemos una revisión inicial sin costo para entender su situación y regularizar lo que esté pendiente, sin importar el tiempo de retraso.' },
];
---

<Layout
  title="Contador Público en Florencia, Caquetá"
  description="Contador Público en Florencia, Caquetá. Asesoría contable, declaración de renta, facturación electrónica y creación de empresas para negocios y personas naturales de la región."
  schema={[serviceSchema({ title: 'Servicios contables en Florencia, Caquetá', description: 'Asesoría contable, tributaria y de constitución de empresas en Florencia, Caquetá.' }, ['Florencia', 'Caquetá']), faqSchema(faqs)]}
>
  <Navbar activePath="/florencia-caqueta/" />
  <Whatsapp />

  <main id="contenido" tabindex="-1" class="focus:outline-none">
    <section class="relative isolate overflow-hidden border-b border-border">
      <div class="bg-aurora pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="bg-dots pointer-events-none absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>
      <div class="container-x pb-14 pt-8 sm:pb-20 sm:pt-10">
      <Breadcrumbs crumbs={[
        { label: 'Inicio', href: '/' },
        { label: 'Contador en Florencia, Caquetá' },
      ]} />
        <div class="mt-8 max-w-3xl sm:mt-12">
          <span class="reveal eyebrow">
            <Icon name="lucide:map-pin" class="h-3.5 w-3.5" aria-hidden="true" /> Florencia, Caquetá
          </span>
          <h1 class="reveal mt-4" data-reveal-delay="60">Contador Público en Florencia, Caquetá</h1>
          <p class="reveal lead mt-5" data-reveal-delay="120">
            Soy {SITE.fullName}, Contador Público de la Universidad de la Amazonia, con oficina en Florencia. Acompaño a comerciantes, transportadores, independientes, agricultores y empresas del Caquetá en su contabilidad, declaración de renta y trámites ante la DIAN y la Cámara de Comercio de Florencia.
          </p>
          <div class="reveal mt-8 flex flex-col gap-3 sm:flex-row" data-reveal-delay="200">
            <a href={waLink('Hola, busco un contador público en Florencia, Caquetá.')} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
              <WaIcon class="h-4 w-4" /> Escribir por WhatsApp
            </a>
            <a href="/contacto/" class="btn btn-secondary btn-lg">
              Agendar cita presencial
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container-x">
        <SectionHeader
          eyebrow="Cómo ayudamos"
          title="Trámites y necesidades contables comunes en Florencia"
          subtitle="Los requerimientos más frecuentes de negocios y personas naturales de la región."
        />
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-2 lg:gap-6" data-stagger>
          <div class="reveal card p-6 sm:p-7">
            <span class="icon-tile mb-5">
              <Icon name="lucide:building-2" class="h-6 w-6" aria-hidden="true" />
            </span>
            <h3 class="mb-2 font-sans text-base font-semibold text-ink">Registro ante la Cámara de Comercio de Florencia</h3>
            <p class="text-muted text-sm leading-relaxed">Constitución de empresas (SAS, persona natural comerciante), matrícula mercantil y renovación anual ante la Cámara de Comercio de Florencia para el Caquetá.</p>
          </div>
          <div class="reveal card p-6 sm:p-7">
            <span class="icon-tile mb-5">
              <Icon name="lucide:tractor" class="h-6 w-6" aria-hidden="true" />
            </span>
            <h3 class="mb-2 font-sans text-base font-semibold text-ink">Comercio, transporte y sector agropecuario</h3>
            <p class="text-muted text-sm leading-relaxed">Contabilidad y régimen tributario adaptados a comerciantes, transportadores y negocios ganaderos o agrícolas de Florencia y el Caquetá.</p>
          </div>
          <div class="reveal card p-6 sm:p-7">
            <span class="icon-tile mb-5">
              <Icon name="lucide:file-text" class="h-6 w-6" aria-hidden="true" />
            </span>
            <h3 class="mb-2 font-sans text-base font-semibold text-ink">Declaración de renta e independientes</h3>
            <p class="text-muted text-sm leading-relaxed">Declaración de renta para personas naturales del Caquetá y facturación electrónica para independientes y profesionales de la región.</p>
          </div>
          <div class="reveal card p-6 sm:p-7">
            <span class="icon-tile mb-5">
              <Icon name="lucide:shield-check" class="h-6 w-6" aria-hidden="true" />
            </span>
            <h3 class="mb-2 font-sans text-base font-semibold text-ink">Cumplimiento ante la DIAN</h3>
            <p class="text-muted text-sm leading-relaxed">RUT, actualizaciones, IVA, retenciones y representación ante requerimientos de la DIAN para negocios y personas del Caquetá.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container-x">
        <SectionHeader
          eyebrow="Servicios"
          title="Servicios disponibles en Florencia"
          subtitle="Portafolio completo de asesoría contable y tributaria."
        />
        <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3 lg:gap-6" role="list" data-stagger>
          {localServices.map((s) => (
            <li class="reveal">
              <article class="card card-interactive group relative flex h-full flex-col p-6 sm:p-7">
                <span class="icon-tile mb-5">
                  <Icon name={s.icon} class="h-6 w-6" aria-hidden="true" />
                </span>
                <h3 class="mb-2 font-sans text-base font-semibold text-ink">
                  <a href={`/servicios/${s.slug}/`} class="stretched-link">{s.title}</a>
                </h3>
                <p class="flex-1 text-sm leading-relaxed text-muted">{s.heroDescription}</p>
                <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700" aria-hidden="true">
                  Ver servicio <Icon name="lucide:arrow-right" class="arrow h-4 w-4" />
                </span>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="container-x">
        <div class="max-w-3xl mx-auto">
          <SectionHeader
            eyebrow="Preguntas frecuentes"
            title="Dudas comunes en Florencia y el Caquetá"
          />
          <Accordion items={faqs} name="faq-florencia" class="reveal mt-10" />
        </div>
      </div>
    </section>

    <CtaFinal />
  </main>

  <Footer />
</Layout>
