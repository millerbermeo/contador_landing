---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Whatsapp from '../../components/Whatsapp.astro';
import Footer from '../../components/Footer.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import WaIcon from '../../components/ui/WaIcon.astro';
import LocalServices from '../../components/local/LocalServices.astro';
import LocalFaq from '../../components/local/LocalFaq.astro';
import { Icon } from 'astro-icon/components';
import { SITE, waLink } from '../../data/site';
import { serviceSchema, faqSchema } from '../../data/schema';
import { services } from '../../data/services';

const localServices = services.filter((s) =>
  ['asesorias-contables', 'declaracion-renta', 'facturacion-electronica', 'creacion-empresas', 'contabilidad-personas', 'consultoria-tributaria'].includes(s.slug)
);

const needs = [
  { icon: 'lucide:building-2', title: 'Registro ante la Cámara de Comercio de Florencia', text: 'Constitución de empresas (SAS, persona natural comerciante), matrícula mercantil y renovación anual ante la Cámara de Comercio de Florencia para el Caquetá.' },
  { icon: 'lucide:tractor', title: 'Comercio, transporte y sector agropecuario', text: 'Contabilidad y régimen tributario adaptados a comerciantes, transportadores y negocios ganaderos o agrícolas de Florencia y el Caquetá.' },
  { icon: 'lucide:file-text', title: 'Declaración de renta e independientes', text: 'Declaración de renta para personas naturales del Caquetá y facturación electrónica para independientes y profesionales de la región.' },
  { icon: 'lucide:shield-check', title: 'Cumplimiento ante la DIAN', text: 'RUT, actualizaciones, IVA, retenciones y representación ante requerimientos de la DIAN para negocios y personas del Caquetá.' },
];
const faqs = [
  { q: '¿Atienden de forma presencial en Florencia?', a: 'Sí. Además de la asesoría por WhatsApp y correo, puede agendar una cita presencial en Florencia para revisar su caso con calma, especialmente para trámites de constitución de empresa o auditorías.' },
  { q: '¿Dónde queda la Cámara de Comercio para registrar mi empresa en Florencia?', a: 'El registro mercantil se realiza ante la Cámara de Comercio de Florencia para el Caquetá. La acompañamos en todo el proceso: elección del tipo societario, documentos, registro y obtención del RUT.' },
  { q: '¿Manejan declaración de renta para personas de Florencia y el Caquetá?', a: 'Sí, es uno de nuestros servicios principales. Revisamos su situación, identificamos deducciones aplicables y presentamos la declaración ante la DIAN dentro de los plazos.' },
  { q: '¿Trabajan con negocios del sector agropecuario y comercial del Caquetá?', a: 'Sí. Buena parte de nuestros clientes en la región son comerciantes, transportadores, ganaderos e independientes que necesitan contabilidad clara y cumplimiento tributario sin complicaciones.' },
  { q: '¿Cómo empiezo si nunca he llevado mi contabilidad al día?', a: 'Hacemos una revisión inicial sin costo para entender su situación y regularizar lo que esté pendiente, sin importar el tiempo de retraso.' },
];
---

<Layout
  title="Contador Público en Florencia, Caquetá"
  description="Contador Público en Florencia, Caquetá. Asesoría contable, declaración de renta, facturación electrónica y creación de empresas para negocios y personas naturales de la región."
  schema={[serviceSchema({ title: 'Servicios contables en Florencia, Caquetá', description: 'Asesoría contable, tributaria y de constitución de empresas en Florencia, Caquetá.' }, ['Florencia', 'Caquetá']), faqSchema(faqs)]}
>
  <Navbar activePath="/florencia-caqueta/" />
  <Whatsapp />

  <main id="contenido" tabindex="-1" class="focus:outline-none">
    <PageHero
      eyebrow="Florencia, Caquetá"
      title="Contador Público en Florencia, Caquetá"
      lead={`Soy ${SITE.fullName}, Contador Público de la Universidad de la Amazonia, con oficina en Florencia. Acompaño a comerciantes, transportadores, independientes, agricultores y empresas del Caquetá en su contabilidad, declaración de renta y trámites ante la DIAN y la Cámara de Comercio de Florencia.`}
      crumbs={[
        { label: 'Inicio', href: '/' },
        { label: 'Contador en Florencia, Caquetá' },
      ]}
    >
      <a href={waLink('Hola, busco un contador público en Florencia, Caquetá.')} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
        <WaIcon class="h-4 w-4" /> Escribir por WhatsApp
      </a>
      <a href="/contacto/" class="btn btn-secondary btn-lg">Agendar cita presencial</a>

      <div slot="aside" class="rounded-panel border border-border bg-surface/80 p-6 shadow-card backdrop-blur-sm">
        <p class="flex items-center gap-2 text-sm font-semibold text-ink">
          <span class="grid h-8 w-8 place-items-center rounded-full bg-accent-soft text-brand-700">
            <Icon name="lucide:map-pin" class="h-4 w-4" aria-hidden="true" />
          </span>
          Atención presencial y en línea
        </p>
        <dl class="mt-5 divide-y divide-border text-sm">
          <div class="flex items-center justify-between gap-4 py-3">
            <dt class="text-muted">Oficina</dt>
            <dd class="font-medium text-ink">{SITE.location}</dd>
          </div>
          <div class="flex items-center justify-between gap-4 py-3">
            <dt class="text-muted">WhatsApp</dt>
            <dd><a href={waLink()} target="_blank" rel="noopener noreferrer" class="link font-medium tabular-nums">{SITE.whatsappDisplay}</a></dd>
          </div>
          <div class="flex items-center justify-between gap-4 py-3">
            <dt class="text-muted">Teléfono</dt>
            <dd><a href={`tel:${SITE.phoneRaw}`} class="link font-medium tabular-nums">{SITE.phone}</a></dd>
          </div>
        </dl>
      </div>
    </PageHero>

    <section class="section" aria-labelledby="florencia-ayuda">
      <div class="container-x">
        <SectionHeader
          id="florencia-ayuda"
          eyebrow="Cómo ayudamos"
          title="Trámites y necesidades contables comunes en Florencia"
          subtitle="Los requerimientos más frecuentes de negocios y personas naturales de la región."
        />
        <ul class="section-body grid gap-5 md:grid-cols-2 lg:gap-6" role="list" data-stagger="80">
          {needs.map((n) => (
            <li class="reveal card flex gap-5 p-6 sm:p-8">
              <span class="icon-tile shrink-0"><Icon name={n.icon} class="h-6 w-6" aria-hidden="true" /></span>
              <div>
                <h3 class="font-sans text-h4 font-semibold text-ink">{n.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{n.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <LocalServices title="Servicios disponibles en Florencia" subtitle="Portafolio completo de asesoría contable y tributaria." items={localServices} />

    <LocalFaq faqs={faqs} name="faq-florencia" title="Dudas comunes en Florencia y el Caquetá"
      other={{ label: '¿Está en el Huila?', text: 'También atiendo Neiva y sus municipios con asesoría remota.', href: '/contador-en-huila/', cta: 'Ver cobertura en el Huila' }} />

    <CtaFinal />
  </main>

  <Footer />
</Layout>
