---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Whatsapp from '../../components/Whatsapp.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import WaIcon from '../../components/ui/WaIcon.astro';
import { Icon } from 'astro-icon/components';
import { SITE, waLink } from '../../data/site';
import { serviceSchema, faqSchema } from '../../data/schema';
import { services } from '../../data/services';

const localServices = services.filter((s) =>
  ['asesorias-contables', 'declaracion-renta', 'facturacion-electronica', 'creacion-empresas', 'contabilidad-personas', 'consultoria-tributaria'].includes(s.slug)
);

const faqs = [
  { q: '¿Atienden de forma presencial en Florencia?', a: 'Sí. Además de la asesoría por WhatsApp y correo, puede agendar una cita presencial en Florencia para revisar su caso con calma, especialmente para trámites de constitución de empresa o auditorías.' },
  { q: '¿Dónde queda la Cámara de Comercio para registrar mi empresa en Florencia?', a: 'El registro mercantil se realiza ante la Cámara de Comercio de Florencia para el Caquetá. La acompañamos en todo el proceso: elección del tipo societario, documentos, registro y obtención del RUT.' },
  { q: '¿Manejan declaración de renta para personas de Florencia y el Caquetá?', a: 'Sí, es uno de nuestros servicios principales. Revisamos su situación, identificamos deducciones aplicables y presentamos la declaración ante la DIAN dentro de los plazos.' },
  { q: '¿Trabajan con negocios del sector agropecuario y comercial del Caquetá?', a: 'Sí. Buena parte de nuestros clientes en la región son comerciantes, transportadores, ganaderos e independientes que necesitan contabilidad clara y cumplimiento tributario sin complicaciones.' },
  { q: '¿Cómo empiezo si nunca he llevado mi contabilidad al día?', a: 'Hacemos una revisión inicial sin costo para entender su situación y regularizar lo que esté pendiente, sin importar el tiempo de retraso.' },
];
---

<Layout
  title="Contador Público en Florencia, Caquetá"
  description="Contador Público en Florencia, Caquetá. Asesoría contable, declaración de renta, facturación electrónica y creación de empresas para negocios y personas naturales de la región."
  schema={[serviceSchema({ title: 'Servicios contables en Florencia, Caquetá', description: 'Asesoría contable, tributaria y de constitución de empresas en Florencia, Caquetá.' }, ['Florencia', 'Caquetá']), faqSchema(faqs)]}
>
  <Navbar activePath="/florencia-caqueta/" />
  <Whatsapp />

  <main>
    <div class="container-x pt-8 pb-4">
      <Breadcrumbs crumbs={[
        { label: 'Inicio', href: '/' },
        { label: 'Contador en Florencia, Caquetá' },
      ]} />
    </div>

    <section class="section pt-0">
      <div class="container-x">
        <div class="max-w-3xl">
          <span class="eyebrow block mb-2 flex items-center gap-2">
            <Icon name="lucide:map-pin" class="w-4 h-4" /> Florencia, Caquetá
          </span>
          <h1 class="text-3xl md:text-4xl mb-4">Contador Público en Florencia, Caquetá</h1>
          <p class="text-muted text-lg leading-relaxed mb-6">
            Soy {SITE.fullName}, Contador Público de la Universidad de la Amazonia, con oficina en Florencia. Acompaño a comerciantes, transportadores, independientes, agricultores y empresas del Caquetá en su contabilidad, declaración de renta y trámites ante la DIAN y la Cámara de Comercio de Florencia.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={waLink('Hola, busco un contador público en Florencia, Caquetá.')} target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-2 min-h-[44px] px-6 rounded-full bg-brand-500 text-white font-semibold text-sm shadow-soft hover:bg-brand-600 hover:shadow-lift hover:-translate-y-0.5 transition-all duration-300">
              <WaIcon class="w-4 h-4" /> Escribir por WhatsApp
            </a>
            <a href="/contacto/"
              class="inline-flex items-center gap-2 min-h-[44px] px-6 rounded-full border border-brand-500 text-brand-700 font-semibold text-sm hover:bg-brand-500 hover:text-white hover:-translate-y-0.5 transition-all duration-300">
              Agendar cita presencial
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section pt-0 bg-brand-50/40">
      <div class="container-x">
        <SectionHeader
          eyebrow="Cómo ayudamos"
          title="Trámites y necesidades contables comunes en Florencia"
          subtitle="Los requerimientos más frecuentes de negocios y personas naturales de la región."
        />
        <div class="grid sm:grid-cols-2 gap-5 mt-10">
          <div class="bg-surface rounded-card border border-border shadow-soft p-6">
            <div class="w-10 h-10 rounded-xl bg-accent-soft grid place-items-center mb-3">
              <Icon name="lucide:building-2" class="w-5 h-5 text-brand-500" />
            </div>
            <h2 class="text-base mb-2">Registro ante la Cámara de Comercio de Florencia</h2>
            <p class="text-muted text-sm leading-relaxed">Constitución de empresas (SAS, persona natural comerciante), matrícula mercantil y renovación anual ante la Cámara de Comercio de Florencia para el Caquetá.</p>
          </div>
          <div class="bg-surface rounded-card border border-border shadow-soft p-6">
            <div class="w-10 h-10 rounded-xl bg-accent-soft grid place-items-center mb-3">
              <Icon name="lucide:tractor" class="w-5 h-5 text-brand-500" />
            </div>
            <h2 class="text-base mb-2">Comercio, transporte y sector agropecuario</h2>
            <p class="text-muted text-sm leading-relaxed">Contabilidad y régimen tributario adaptados a comerciantes, transportadores y negocios ganaderos o agrícolas de Florencia y el Caquetá.</p>
          </div>
          <div class="bg-surface rounded-card border border-border shadow-soft p-6">
            <div class="w-10 h-10 rounded-xl bg-accent-soft grid place-items-center mb-3">
              <Icon name="lucide:file-text" class="w-5 h-5 text-brand-500" />
            </div>
            <h2 class="text-base mb-2">Declaración de renta e independientes</h2>
            <p class="text-muted text-sm leading-relaxed">Declaración de renta para personas naturales del Caquetá y facturación electrónica para independientes y profesionales de la región.</p>
          </div>
          <div class="bg-surface rounded-card border border-border shadow-soft p-6">
            <div class="w-10 h-10 rounded-xl bg-accent-soft grid place-items-center mb-3">
              <Icon name="lucide:shield-check" class="w-5 h-5 text-brand-500" />
            </div>
            <h2 class="text-base mb-2">Cumplimiento ante la DIAN</h2>
            <p class="text-muted text-sm leading-relaxed">RUT, actualizaciones, IVA, retenciones y representación ante requerimientos de la DIAN para negocios y personas del Caquetá.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container-x">
        <SectionHeader
          eyebrow="Servicios"
          title="Servicios disponibles en Florencia"
          subtitle="Portafolio completo de asesoría contable y tributaria."
        />
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
          {localServices.map((s) => (
            <a href={`/servicios/${s.slug}/`}
              class="group bg-surface rounded-card border border-border shadow-soft p-6 flex flex-col transition-all duration-300 hover:-translate-y-1 hover:shadow-lift hover:border-accent">
              <div class="w-11 h-11 rounded-xl bg-accent-soft grid place-items-center mb-4 group-hover:bg-brand-500 transition-colors duration-300">
                <Icon name={s.icon} class="w-5 h-5 text-brand-500 group-hover:text-white transition-colors duration-300" />
              </div>
              <h3 class="text-base mb-2">{s.title}</h3>
              <p class="text-muted text-sm leading-relaxed flex-1">{s.heroDescription}</p>
              <span class="inline-flex items-center gap-1 text-brand-500 text-sm font-semibold mt-4">
                Ver servicio <Icon name="lucide:arrow-right" class="w-4 h-4" />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section bg-brand-50/40">
      <div class="container-x">
        <div class="max-w-3xl mx-auto">
          <SectionHeader
            eyebrow="Preguntas frecuentes"
            title="Dudas comunes en Florencia y el Caquetá"
          />
          <div class="mt-8 space-y-2">
            {faqs.map((faq) => (
              <details class="faq-item bg-surface border border-border rounded-2xl overflow-hidden group">
                <summary class="flex justify-between items-center gap-4 px-5 py-4 text-left font-semibold text-ink text-sm cursor-pointer list-none">
                  {faq.q}
                  <Icon name="lucide:plus" class="w-4 h-4 text-brand-500 shrink-0 group-open:rotate-45 transition-transform" />
                </summary>
                <p class="px-5 pb-5 text-muted text-sm leading-relaxed border-t border-border pt-4">{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <CtaFinal />
  </main>

  <Footer />
</Layout>
