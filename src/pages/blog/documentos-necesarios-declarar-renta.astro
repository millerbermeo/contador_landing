---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Whatsapp from '../../components/Whatsapp.astro';
import Footer from '../../components/Footer.astro';
import BlogDetail from '../../components/BlogDetail.astro';
import { blogPosts } from '../../data/blog';
import { blogPostSchema } from '../../data/schema';

const post = blogPosts.find((p) => p.slug === 'documentos-necesarios-declarar-renta')!;
---

<Layout
  title={post.title}
  description={post.metaDescription}
  type="article"
  publishedTime={post.date}
  schema={blogPostSchema(post)}
>
  <Navbar activePath="/blog/" />
  <Whatsapp />

  <main id="contenido" tabindex="-1" class="focus:outline-none">
    <BlogDetail post={post} />
  </main>

  <Footer />
</Layout>
