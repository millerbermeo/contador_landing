---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Whatsapp from '../../components/Whatsapp.astro';
import Footer from '../../components/Footer.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { Icon } from 'astro-icon/components';
import { blogPosts } from '../../data/blog';
const fmt = new Intl.DateTimeFormat('es-CO', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Layout
  title="Blog de Contabilidad y Finanzas"
  description="Artículos y guías sobre contabilidad, declaración de renta, facturación electrónica, creación de empresas y finanzas en Colombia."
>
  <Navbar activePath="/blog/" />
  <Whatsapp />

  <main id="contenido" tabindex="-1" class="focus:outline-none">
    <PageHero
      eyebrow="Blog"
      title="Artículos y Guías"
      lead="Información actualizada sobre contabilidad, tributaria y finanzas en Colombia."
      crumbs={[
        { label: 'Inicio', href: '/' },
        { label: 'Blog' },
      ]}
    />

    <section class="section" aria-label="Artículos">
      <div class="container-x">
        <ul class="grid gap-5 md:grid-cols-2 lg:gap-6" role="list" data-stagger>
          {blogPosts.map((post) => {
            const words = post.content.split(/\s+/).length;
            const readTime = Math.max(1, Math.round(words / 200));
            return (
              <li class="reveal">
                <article class="card card-interactive group relative flex h-full flex-col p-6 sm:p-8">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-muted">
                    <span class="chip-brand">{post.category}</span>
                    <time datetime={post.date}>{fmt.format(new Date(post.date))}</time>
                    <span class="inline-flex items-center gap-1">
                      <Icon name="lucide:clock" class="h-3 w-3" aria-hidden="true" /> {readTime} min de lectura
                    </span>
                  </div>
                  <h2 class="mt-4 text-h4 leading-snug">
                    <a href={`/blog/${post.slug}/`} class="stretched-link">{post.title}</a>
                  </h2>
                  <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{post.description}</p>
                  <div class="mt-6 flex items-center justify-between gap-4 border-t border-border pt-4">
                    <span class="text-xs text-muted">Por {post.author}</span>
                    <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700" aria-hidden="true">
                      Leer artículo <Icon name="lucide:arrow-right" class="arrow h-4 w-4" />
                    </span>
                  </div>
                </article>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <section class="section-tight">
      <div class="container-x">
        <div class="reveal card mx-auto flex max-w-3xl flex-col items-center gap-5 bg-sunken p-8 text-center shadow-none sm:p-10">
          <span class="icon-tile"><Icon name="lucide:rss" class="h-6 w-6" aria-hidden="true" /></span>
          <h2 class="text-h3">¿Temas de interés?</h2>
          <p class="max-w-md text-muted">Si desea que escribamos sobre un tema contable específico, contáctenos y lo tendremos en cuenta.</p>
          <a href="/contacto/" class="btn btn-secondary">Sugerir tema</a>
        </div>
      </div>
    </section>

    <CtaFinal />
  </main>

  <Footer />
</Layout>
