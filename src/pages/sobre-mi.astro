---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Whatsapp from '../components/Whatsapp.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import AboutMe from '../components/AboutMe.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { SITE, waLink, COVERAGE_LINKS } from '../data/site';
import { services } from '../data/services';
import { personSchema } from '../data/schema';
import brianImg from '../assets/brian.jpeg';

const facts = [
  { icon: 'lucide:map-pin', label: 'Ubicación', value: `${SITE.location}, Colombia` },
  { icon: 'lucide:clock', label: 'Experiencia', value: '+5 años' },
  { icon: 'lucide:book-open', label: 'Formación', value: 'Universidad de la Amazonia' },
  { icon: 'lucide:badge-check', label: 'Registro', value: 'Tarjeta Profesional Vigente' },
  { icon: 'lucide:scale', label: 'Especialidad', value: 'Contabilidad y Tributaria' },
  { icon: 'lucide:heart-handshake', label: 'Clientes', value: 'Empresas y Personas Naturales' },
];
---

<Layout
  title="Sobre Mí | Brian Pedraza Osorio — Contador Público en Colombia"
  description="Conozca a Brian Pedraza Osorio, Contador Público de la Universidad de la Amazonia con más de 5 años de experiencia en asesoría contable, tributaria y fiscal en Florencia, Caquetá."
  schema={personSchema()}
>
  <Navbar activePath="/sobre-mi/" />
  <Whatsapp />

  <main id="contenido" tabindex="-1" class="focus:outline-none">
    <section class="relative isolate overflow-hidden border-b border-border">
      <div class="bg-aurora pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="container-x pb-14 pt-8 sm:pb-20 sm:pt-10">
        <Breadcrumbs crumbs={[
          { label: 'Inicio', href: '/' },
          { label: 'Sobre Mí' },
        ]} />

        <div class="mt-8 grid items-center gap-10 sm:mt-12 md:grid-cols-12 lg:gap-16">
          <div class="reveal md:col-span-5">
            <div class="relative mx-auto aspect-square w-full max-w-sm overflow-hidden rounded-hero bg-gradient-to-br from-brand-50 via-accent-soft to-brand-100 shadow-lift ring-1 ring-inset ring-black/5">
              <Image src={brianImg} alt={`${SITE.fullName}, Contador Público en Colombia`}
                widths={[320, 480, 704]} sizes="(min-width: 768px) 384px, 90vw"
                format="webp" loading="eager" fetchpriority="high"
                class="h-full w-full object-cover mix-blend-multiply" />
            </div>
          </div>

          <div class="md:col-span-7">
            <span class="reveal eyebrow">Sobre Mí</span>
            <h1 class="reveal mt-4" data-reveal-delay="60">{SITE.fullName}</h1>
            <p class="reveal mt-3 text-lg font-semibold text-brand-700" data-reveal-delay="100">{SITE.role}</p>
            <p class="reveal lead mt-5 max-w-prose" data-reveal-delay="140">
              Soy Brian Pedraza Osorio, Contador Público. Acompaño a empresarios, emprendedores y personas naturales en la organización de su información contable y el cumplimiento de sus obligaciones tributarias. Mi objetivo es que puedas entender mejor tus números y tomar decisiones con información clara y confiable.
            </p>

            <dl class="mt-8 grid grid-cols-1 gap-3 min-[420px]:grid-cols-2 lg:grid-cols-3" data-stagger>
              {facts.map((f) => (
                <div class="reveal flex items-center gap-3 rounded-2xl border border-border bg-surface/80 p-3">
                  <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-accent-soft text-brand-700">
                    <Icon name={f.icon} class="h-4 w-4" aria-hidden="true" />
                  </span>
                  <div class="min-w-0">
                    <dt class="text-2xs font-medium uppercase tracking-wide text-muted">{f.label}</dt>
                    <dd class="text-sm font-semibold leading-snug text-ink">{f.value}</dd>
                  </div>
                </div>
              ))}
            </dl>

            <div class="reveal mt-8">
              <a href={waLink('Hola Brian, me gustaría agendar una asesoría contable.')} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
                <Icon name="lucide:calendar-check" class="h-4 w-4" aria-hidden="true" /> Agendar Asesoría
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-tint" aria-labelledby="practica">
      <div class="container-x">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <div class="lg:sticky lg:top-28">
              <SectionHeader
                id="practica"
                align="left"
                eyebrow="Áreas de práctica"
                title="En qué puedo ayudarle"
                subtitle="Servicios contables y tributarios para empresas, emprendedores y personas naturales."
              />
              <a href="/servicios/" class="btn btn-secondary mt-8">
                Ver todos los servicios <Icon name="lucide:arrow-right" class="arrow h-4 w-4" aria-hidden="true" />
              </a>
            </div>
          </div>

          <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-8" role="list" data-stagger>
            {services.map((sv) => (
              <li class="reveal">
                <article class="card card-interactive group relative flex h-full items-start gap-4 p-5 sm:p-6">
                  <span class="icon-tile"><Icon name={sv.icon} class="h-5 w-5" aria-hidden="true" /></span>
                  <div class="min-w-0">
                    <h3 class="font-sans text-base font-semibold leading-snug text-ink">
                      <a href={`/servicios/${sv.slug}/`} class="stretched-link">{sv.title}</a>
                    </h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-muted">{sv.heroDescription}</p>
                  </div>
                </article>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-16 border-t border-border pt-12">
          <h3 class="text-h4">Cobertura</h3>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2" role="list">
            {COVERAGE_LINKS.map((c, i) => (
              <li class="reveal">
                <a href={c.href} class="card card-interactive group flex min-h-[44px] items-center gap-4 p-5 sm:p-6">
                  <span class="icon-tile"><Icon name={i === 0 ? 'lucide:map-pin' : 'lucide:laptop'} class="h-5 w-5" aria-hidden="true" /></span>
                  <span class="flex-1">
                    <span class="block font-semibold text-ink">{c.label}</span>
                    <span class="block text-sm text-muted">{i === 0 ? 'Atención presencial y en línea' : 'Asesoría remota'}</span>
                  </span>
                  <Icon name="lucide:arrow-right" class="arrow h-4 w-4 text-brand-700" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <AboutMe />
    <CtaFinal />
  </main>

  <Footer />
</Layout>
