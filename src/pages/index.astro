---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Whatsapp from '../components/Whatsapp.astro';
import Home from '../components/Home.astro';
import ServiceCard from '../components/ServiceCard.astro';
import AuthorCard from '../components/AuthorCard.astro';
import AboutMe from '../components/AboutMe.astro';
import Testimonials from '../components/Testimonials.astro';
import Tarifa from '../components/Tarifa.astro';
import MenuAcordeon, { faqs } from '../components/MenuAcordeon.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { Icon } from 'astro-icon/components';
import { SITE, waLink } from '../data/site';
import { services } from '../data/services';
import { accountingServiceSchema, faqSchema, organizationSchema, websiteSchema } from '../data/schema';

const serviceGroups = [
  {
    icon: 'lucide:building-2',
    title: 'Empresas',
    items: ['Contabilidad', 'Nómina', 'Impuestos', 'Facturación electrónica', 'Consultoría financiera'],
    whatsappMessage: 'Hola, me gustaría información sobre servicios contables para empresas.',
  },
  {
    icon: 'lucide:rocket',
    title: 'Emprendedores',
    items: ['Creación de empresas', 'RUT', 'Facturación electrónica', 'Organización contable inicial'],
    whatsappMessage: 'Hola, estoy emprendiendo y necesito asesoría contable.',
  },
  {
    icon: 'lucide:user-check',
    title: 'Personas naturales',
    items: ['Declaración de renta', 'RUT', 'Obligaciones tributarias', 'Orientación financiera'],
    whatsappMessage: 'Hola, soy persona natural y necesito asesoría contable.',
  },
];

const trustPoints = [
  { icon: 'lucide:badge-check', label: 'Tarjeta profesional vigente' },
  { icon: 'lucide:clock', label: '+5 años de experiencia' },
  { icon: 'lucide:shield-check', label: 'Cumplimiento normativo DIAN' },
  { icon: 'lucide:message-circle', label: 'Respuesta rápida por WhatsApp' },
];
---

<Layout
  title="Líderes en Contabilidad | Asesoría Contable, Fiscal y Trámites DIAN"
  description="Contador Público certificado en Colombia. Asesorías contables, declaración de renta, facturación electrónica y trámites ante la DIAN para empresas y personas naturales en Florencia, Caquetá."
  schema={[accountingServiceSchema(), organizationSchema(), websiteSchema()]}
>
  <Navbar activePath="/" />
  <Whatsapp />

  <main id="contenido" tabindex="-1" class="focus:outline-none">
    <Home />

    <section id="servicios" class="section" aria-labelledby="servicios-titulo">
      <div class="container-x">
        <SectionHeader
          id="servicios-titulo"
          eyebrow="Portafolio"
          title="Servicios Profesionales"
          subtitle="Soluciones contables y fiscales adaptadas a las necesidades de su empresa."
        />
        <div class="section-body grid w-full gap-5 md:grid-cols-3 lg:gap-6">
          {serviceGroups.map((group, i) => (
            <ServiceCard
              icon={group.icon}
              title={group.title}
              items={group.items}
              whatsappMessage={group.whatsappMessage}
              delay={i * 100}
            />
          ))}
        </div>
        <div class="reveal mt-10 flex justify-center">
          <a href="/servicios/" class="btn btn-secondary">
            Ver los {services.length} servicios en detalle <Icon name="lucide:arrow-right" class="arrow h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>

    <AuthorCard />
    <AboutMe tone="dark" />
    <Testimonials />
    <Tarifa />

    <section id="faq" class="section">
      <div class="container-x">
        <SectionHeader
          eyebrow="Preguntas Frecuentes"
          title="¿Tiene dudas?"
          subtitle="Resolvemos sus inquietudes sobre contabilidad y finanzas."
        />

        <div class="section-body grid w-full items-start gap-8 lg:grid-cols-[1.4fr_1fr] lg:gap-12">
          <div class="reveal">
            <MenuAcordeon />
            <a href="/preguntas-frecuentes/" class="link mt-6 inline-flex min-h-[44px] items-center gap-1.5">
              Ver todas las preguntas frecuentes <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
            </a>
            <script type="application/ld+json" is:inline set:html={JSON.stringify({
              '@context': 'https://schema.org',
              ...faqSchema(faqs.map((f) => ({ q: f.question, a: f.answer }))),
            })} />
          </div>

          <div class="reveal flex flex-col gap-5 lg:sticky lg:top-24" data-reveal-delay="120">
            <div class="card flex flex-col gap-6 p-6 sm:p-7">
              <h3>Por qué confiar en {SITE.fullName}</h3>
              <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2" role="list">
                {trustPoints.map((t) => (
                  <li class="flex items-center gap-3">
                    <span class="icon-tile h-10 w-10 rounded-lg">
                      <Icon name={t.icon} class="h-4 w-4" aria-hidden="true" />
                    </span>
                    <span class="text-sm text-ink font-medium leading-tight">{t.label}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="card flex flex-col items-start gap-4 bg-brand-dark p-6 sm:p-7 border-0">
              <p class="font-serif text-xl font-medium text-white">¿Más preguntas sobre tarifas o servicios?</p>
              <a href={waLink('Hola, tengo algunas preguntas sobre sus servicios.')} target="_blank" rel="noopener noreferrer"
                class="btn btn-inverse">
                Contáctenos <Icon name="lucide:arrow-right" class="arrow h-4 w-4" aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <CtaFinal />
  </main>

  <Footer />
</Layout>
