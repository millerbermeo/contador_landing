---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Whatsapp from '../components/Whatsapp.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaFinal from '../components/CtaFinal.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import WaIcon from '../components/ui/WaIcon.astro';
import { Icon } from 'astro-icon/components';
import { SITE, waLink } from '../data/site';

const contactMethods = [
  {
    icon: 'lucide:message-circle',
    title: 'WhatsApp',
    value: SITE.whatsappDisplay,
    action: waLink('Hola, me gustaría contactarlos.'),
    label: 'Escribir por WhatsApp',
    color: 'bg-brand-500',
  },
  {
    icon: 'lucide:mail',
    title: 'Correo Electrónico',
    value: SITE.email,
    action: `mailto:${SITE.email}`,
    label: 'Enviar correo',
    color: 'bg-blue-500',
  },
  {
    icon: 'lucide:phone',
    title: 'Teléfono',
    value: SITE.phone,
    action: `tel:${SITE.phoneRaw}`,
    label: 'Llamar ahora',
    color: 'bg-emerald-500',
  },
  {
    icon: 'lucide:map-pin',
    title: 'Ubicación',
    value: `${SITE.location}, Colombia`,
    action: 'https://maps.google.com/?q=Florencia+Caqueta+Colombia',
    label: 'Ver en Google Maps',
    color: 'bg-rose-500',
  },
];
---

<Layout
  title="Contacto | BP Asesorías Contables"
  description="Contáctenos para recibir asesoría contable personalizada. WhatsApp, correo electrónico o teléfono. Estamos en Florencia, Caquetá para atenderle."
>
  <Navbar activePath="/contacto/" />
  <Whatsapp />

  <main>
    <div class="container-x pt-8 pb-4">
      <Breadcrumbs crumbs={[
        { label: 'Inicio', href: '/' },
        { label: 'Contacto' },
      ]} />
    </div>

    <section class="section pt-0">
      <div class="container-x">
        <div class="max-w-4xl mx-auto">
          <SectionHeader
            eyebrow="Contacto"
            title="Estamos para Ayudarle"
            subtitle="Elija el canal de su preferencia y recibirá atención personalizada."
          />

          <div class="grid sm:grid-cols-2 gap-6 mt-10">
            {contactMethods.map((m, i) => (
              <a href={m.action} target={m.icon === 'lucide:phone' ? undefined : '_blank'} rel="noopener noreferrer"
                class="reveal group bg-surface rounded-card border border-border shadow-soft p-6 flex items-start gap-4 transition-all duration-300 hover:-translate-y-1 hover:shadow-lift hover:border-accent"
                data-reveal-delay={i * 100}>
                <div class={`w-12 h-12 rounded-xl ${m.color} grid place-items-center shrink-0 group-hover:scale-110 transition-transform duration-300`}>
                  <Icon name={m.icon} class="w-6 h-6 text-white" />
                </div>
                <div class="min-w-0">
                  <h3 class="text-base mb-0.5">{m.title}</h3>
                  <p class="text-muted text-sm mb-2">{m.value}</p>
                  <span class="inline-flex items-center gap-1 text-brand-500 text-sm font-semibold">
                    {m.label}
                    <Icon name="lucide:arrow-right" class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                  </span>
                </div>
              </a>
            ))}
          </div>

          <div class="mt-12 bg-brand-50/60 rounded-card border border-border p-8 text-center">
            <h2 class="text-2xl mb-3">Horario de Atención</h2>
            <div class="inline-flex flex-col items-center gap-2 text-muted">
              <div class="flex items-center gap-2">
                <Icon name="lucide:clock" class="w-4 h-4 text-brand-500" />
                <span class="font-semibold text-ink">Lunes a Viernes:</span> 8:00 AM — 6:00 PM
              </div>
              <div class="flex items-center gap-2">
                <Icon name="lucide:clock" class="w-4 h-4 text-brand-500" />
                <span class="font-semibold text-ink">Sábados:</span> 8:00 AM — 1:00 PM
              </div>
            </div>
            <p class="text-muted text-sm mt-4">
              También puede contactarnos por WhatsApp fuera del horario laboral. Le responderemos a la brevedad.
            </p>
          </div>
        </div>
      </div>
    </section>

    <CtaFinal />
  </main>

  <Footer />
</Layout>
