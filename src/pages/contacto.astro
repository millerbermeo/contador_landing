---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Whatsapp from '../components/Whatsapp.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/ui/PageHero.astro';
import { Icon } from 'astro-icon/components';
import WaIcon from '../components/ui/WaIcon.astro';
import { SITE, waLink } from '../data/site';

const contactMethods = [
  {
    icon: 'lucide:message-circle',
    title: 'WhatsApp',
    value: SITE.whatsappDisplay,
    action: waLink('Hola, me gustaría contactarlos.'),
    label: 'Escribir por WhatsApp',
  },
  {
    icon: 'lucide:mail',
    title: 'Correo Electrónico',
    value: SITE.email,
    action: `mailto:${SITE.email}`,
    label: 'Enviar correo',
  },
  {
    icon: 'lucide:phone',
    title: 'Teléfono',
    value: SITE.phone,
    action: `tel:${SITE.phoneRaw}`,
    label: 'Llamar ahora',
  },
  {
    icon: 'lucide:map-pin',
    title: 'Ubicación',
    value: `${SITE.location}, Colombia`,
    action: 'https://maps.google.com/?q=Florencia+Caqueta+Colombia',
    label: 'Ver en Google Maps',
  },
];

const [primary, ...secondary] = contactMethods;

const schedule = [
  { day: 'Lunes a Viernes:', hours: '8:00 AM — 6:00 PM' },
  { day: 'Sábados:', hours: '8:00 AM — 1:00 PM' },
];
---

<Layout
  title="Contacto"
  description="Contáctenos para recibir asesoría contable personalizada. WhatsApp, correo electrónico o teléfono. Estamos en Florencia, Caquetá para atenderle."
>
  <Navbar activePath="/contacto/" />
  <Whatsapp />

  <main id="contenido" tabindex="-1" class="focus:outline-none">
    <PageHero
      eyebrow="Contacto"
      title="Estamos para Ayudarle"
      lead="Elija el canal de su preferencia y recibirá atención personalizada."
      crumbs={[
        { label: 'Inicio', href: '/' },
        { label: 'Contacto' },
      ]}
    >
      <div slot="aside" class="card p-6 sm:p-7">
        <div class="flex items-center gap-3">
          <span class="icon-tile h-10 w-10 rounded-lg"><Icon name="lucide:clock" class="h-5 w-5" aria-hidden="true" /></span>
          <h2 id="horario" class="text-h4">Horario de Atención</h2>
        </div>
        <dl class="mt-4 divide-y divide-border text-sm">
          {schedule.map((r) => (
            <div class="flex items-center justify-between gap-4 py-3">
              <dt class="font-semibold text-ink">{r.day}</dt>
              <dd class="text-muted tabular-nums">{r.hours}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          También puede contactarnos por WhatsApp fuera del horario laboral. Le responderemos a la brevedad.
        </p>
      </div>
    </PageHero>

    <section class="section" aria-labelledby="canales">
      <div class="container-x">
        <h2 id="canales" class="sr-only">Canales de contacto</h2>

        <article class="reveal card group relative isolate overflow-hidden border-0 bg-brand-dark p-6 text-white shadow-float sm:p-10">
          <div class="pointer-events-none absolute -right-24 -top-24 -z-10 h-80 w-80 rounded-full bg-accent/20 blur-3xl" aria-hidden="true"></div>
          <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
            <div class="flex items-start gap-5">
              <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-white/10 ring-1 ring-inset ring-white/15">
                <WaIcon class="h-7 w-7 text-accent" />
              </span>
              <div>
                <p class="text-2xs font-semibold uppercase tracking-[0.14em] text-accent">Canal recomendado</p>
                <h3 class="mt-1 font-sans text-xl font-semibold text-white">{primary.title}</h3>
                <p class="mt-1 text-lg tabular-nums text-white/80">{primary.value}</p>
              </div>
            </div>
            <a href={primary.action} target="_blank" rel="noopener noreferrer" class="btn btn-inverse btn-lg w-full md:w-auto">
              {primary.label}
              <Icon name="lucide:arrow-right" class="arrow h-4 w-4" aria-hidden="true" />
            </a>
          </div>
        </article>

        <ul class="mt-5 grid gap-5 sm:grid-cols-3 lg:gap-6" role="list" data-stagger>
          {secondary.map((m) => {
            const external = m.action.startsWith('http');
            return (
              <li class="reveal">
                <article class="card card-interactive group relative flex h-full flex-col p-6 sm:p-7">
                  <span class="icon-tile mb-5">
                    <Icon name={m.icon} class="h-6 w-6" aria-hidden="true" />
                  </span>
                  <h3 class="font-sans text-base font-semibold text-ink">{m.title}</h3>
                  <p class="mt-1 flex-1 break-words text-sm text-muted">{m.value}</p>
                  <a href={m.action} class="stretched-link mt-5 inline-flex min-h-[44px] items-center gap-1.5 text-sm font-semibold text-brand-700"
                    {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                    {m.label}
                    <Icon name="lucide:arrow-right" class="arrow h-4 w-4" aria-hidden="true" />
                  </a>
                </article>
              </li>
            );
          })}
        </ul>

        <div class="reveal card mt-5 bg-sunken p-6 shadow-none lg:hidden">
          <div class="flex items-center gap-3">
            <span class="icon-tile h-10 w-10 rounded-lg bg-surface"><Icon name="lucide:clock" class="h-5 w-5" aria-hidden="true" /></span>
            <h3 id="horario-movil" class="text-h4">Horario de Atención</h3>
          </div>
          <dl class="mt-4 divide-y divide-border text-sm">
            {schedule.map((r) => (
              <div class="flex items-center justify-between gap-4 py-3">
                <dt class="font-semibold text-ink">{r.day}</dt>
                <dd class="text-muted tabular-nums">{r.hours}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            También puede contactarnos por WhatsApp fuera del horario laboral. Le responderemos a la brevedad.
          </p>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
