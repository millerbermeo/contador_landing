---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Whatsapp from '../components/Whatsapp.astro';
import Footer from '../components/Footer.astro';
import CtaFinal from '../components/CtaFinal.astro';
import PageHero from '../components/ui/PageHero.astro';
import { Icon } from 'astro-icon/components';
import { SITE, waLink } from '../data/site';

const contactMethods = [
  {
    icon: 'lucide:message-circle',
    title: 'WhatsApp',
    value: SITE.whatsappDisplay,
    action: waLink('Hola, me gustaría contactarlos.'),
    label: 'Escribir por WhatsApp',
  },
  {
    icon: 'lucide:mail',
    title: 'Correo Electrónico',
    value: SITE.email,
    action: `mailto:${SITE.email}`,
    label: 'Enviar correo',
  },
  {
    icon: 'lucide:phone',
    title: 'Teléfono',
    value: SITE.phone,
    action: `tel:${SITE.phoneRaw}`,
    label: 'Llamar ahora',
  },
  {
    icon: 'lucide:map-pin',
    title: 'Ubicación',
    value: `${SITE.location}, Colombia`,
    action: 'https://maps.google.com/?q=Florencia+Caqueta+Colombia',
    label: 'Ver en Google Maps',
  },
];
---

<Layout
  title="Contacto"
  description="Contáctenos para recibir asesoría contable personalizada. WhatsApp, correo electrónico o teléfono. Estamos en Florencia, Caquetá para atenderle."
>
  <Navbar activePath="/contacto/" />
  <Whatsapp />

  <main id="contenido" tabindex="-1" class="focus:outline-none">
    <PageHero
      eyebrow="Contacto"
      title="Estamos para Ayudarle"
      lead="Elija el canal de su preferencia y recibirá atención personalizada."
      crumbs={[
        { label: 'Inicio', href: '/' },
        { label: 'Contacto' },
      ]}
    />

    <section class="section">
      <div class="container-x">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
          <ul class="grid gap-5 sm:grid-cols-2 lg:col-span-8" role="list" data-stagger aria-label="Canales de contacto">
            {contactMethods.map((m, i) => {
              const external = m.action.startsWith('http');
              return (
                <li class="reveal">
                  <article class={`card card-interactive group relative flex h-full flex-col p-6 sm:p-7 ${i === 0 ? 'ring-1 ring-inset ring-brand-200' : ''}`}>
                    <span class="icon-tile mb-5">
                      <Icon name={m.icon} class="h-6 w-6" aria-hidden="true" />
                    </span>
                    <h2 class="text-base font-sans font-semibold text-ink">{m.title}</h2>
                    <p class="mt-1 break-words text-sm text-muted">{m.value}</p>
                    <a href={m.action} class="stretched-link mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700"
                      {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                      {m.label}
                      <Icon name="lucide:arrow-right" class="arrow h-4 w-4" aria-hidden="true" />
                    </a>
                  </article>
                </li>
              );
            })}
          </ul>

          <aside class="reveal lg:col-span-4" aria-labelledby="horario">
            <div class="card bg-sunken p-7 shadow-none lg:sticky lg:top-28">
              <span class="icon-tile mb-5"><Icon name="lucide:clock" class="h-6 w-6" aria-hidden="true" /></span>
              <h2 id="horario" class="text-h4">Horario de Atención</h2>
              <dl class="mt-5 divide-y divide-border text-sm">
                <div class="flex items-center justify-between gap-4 py-3">
                  <dt class="font-semibold text-ink">Lunes a Viernes:</dt>
                  <dd class="text-muted tabular-nums">8:00 AM — 6:00 PM</dd>
                </div>
                <div class="flex items-center justify-between gap-4 py-3">
                  <dt class="font-semibold text-ink">Sábados:</dt>
                  <dd class="text-muted tabular-nums">8:00 AM — 1:00 PM</dd>
                </div>
              </dl>
              <p class="mt-5 text-sm leading-relaxed text-muted">
                También puede contactarnos por WhatsApp fuera del horario laboral. Le responderemos a la brevedad.
              </p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <CtaFinal />
  </main>

  <Footer />
</Layout>
