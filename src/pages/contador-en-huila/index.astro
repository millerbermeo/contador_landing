---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Whatsapp from '../../components/Whatsapp.astro';
import Footer from '../../components/Footer.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import WaIcon from '../../components/ui/WaIcon.astro';
import LocalServices from '../../components/local/LocalServices.astro';
import LocalFaq from '../../components/local/LocalFaq.astro';
import { Icon } from 'astro-icon/components';
import { waLink } from '../../data/site';
import { serviceSchema, faqSchema } from '../../data/schema';
import { services } from '../../data/services';

const huilaMunicipios = [
  'Neiva', 'Pitalito', 'Garzón', 'La Plata', 'Campoalegre', 'Gigante',
  'San Agustín', 'Palermo', 'Rivera', 'Aipe', 'Timaná', 'Isnos', 'Acevedo',
];

const steps = [
  { icon: 'lucide:message-circle', title: 'Cuéntenos su caso', text: 'Escriba por WhatsApp indicando si es persona natural o empresa, y qué necesita: declaración de renta, contabilidad, facturación electrónica u otro trámite.' },
  { icon: 'lucide:file-up', title: 'Envíe sus documentos', text: 'RUT, extractos, facturas o soportes se envían digitalmente. Revisamos su información y le confirmamos qué falta, sin necesidad de reuniones presenciales.' },
  { icon: 'lucide:badge-check', title: 'Presentación y cumplimiento', text: 'Presentamos su declaración o trámite ante la DIAN de forma electrónica, dentro de los plazos legales, con soporte por videollamada si lo necesita.' },
];

const localServices = services.filter((s) =>
  ['asesorias-contables', 'declaracion-renta', 'facturacion-electronica', 'creacion-empresas', 'contabilidad-empresas', 'consultoria-tributaria'].includes(s.slug)
);

const faqs = [
  { q: '¿Puedo contratar un contador que no tiene oficina en mi ciudad del Huila?', a: 'Sí. La mayoría de la gestión contable y tributaria se puede hacer completamente en línea: envío de documentos por WhatsApp o correo, firma electrónica y reuniones por videollamada. No necesita que el contador esté físicamente en su ciudad.' },
  { q: '¿Cómo funciona la asesoría contable a distancia?', a: 'Usted envía sus documentos (facturas, extractos, RUT) por WhatsApp o correo electrónico. Revisamos su información, resolvemos dudas por videollamada o llamada, y presentamos sus declaraciones directamente ante la DIAN de forma electrónica.' },
  { q: '¿Atienden empresas y personas naturales de Neiva y otros municipios del Huila?', a: 'Sí, atendemos empresas, comerciantes, independientes y personas naturales en Neiva, Pitalito, Garzón, La Plata y demás municipios del Huila mediante asesoría remota.' },
  { q: '¿Es igual de confiable que un contador presencial?', a: 'Sí. Los trámites ante la DIAN y la Cámara de Comercio ya son en su mayoría digitales. Lo importante es la calidad del acompañamiento y el cumplimiento de plazos, no la ubicación física de la oficina.' },
  { q: '¿Qué necesito para empezar si estoy en el Huila?', a: 'Basta con escribirnos por WhatsApp contándonos su caso. Le indicamos qué documentos enviar y en cuánto tiempo puede tener resuelta su situación contable o tributaria.' },
];
---

<Layout
  title="Contador Público para el Huila (Neiva y municipios)"
  description="Asesoría contable y tributaria a distancia para Neiva, Pitalito, Garzón, La Plata y demás municipios del Huila. Declaración de renta, facturación electrónica y trámites DIAN por WhatsApp y videollamada."
  schema={[serviceSchema({ title: 'Servicios contables remotos para el Huila', description: 'Asesoría contable y tributaria a distancia para empresas y personas naturales del Huila.' }, ['Huila', 'Neiva', 'Pitalito', 'Garzón', 'La Plata']), faqSchema(faqs)]}
>
  <Navbar activePath="/contador-en-huila/" />
  <Whatsapp />

  <main id="contenido" tabindex="-1" class="focus:outline-none">
    <PageHero
      eyebrow="Huila · Asesoría remota"
      title="Contador Público para el Huila: Neiva y municipios cercanos"
      lead="Ofrezco asesoría contable y tributaria a distancia para empresas, comerciantes, independientes y personas naturales del Huila. La gestión documental, la comunicación y la presentación de declaraciones se realizan de forma remota, por WhatsApp, correo electrónico y videollamada, con la misma calidad y cumplimiento de plazos que una atención presencial."
      crumbs={[
        { label: 'Inicio', href: '/' },
        { label: 'Contador para el Huila' },
      ]}
      asideMobile
    >
      <a href={waLink('Hola, estoy en el Huila y busco un contador público a distancia.')} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
        <WaIcon class="h-4 w-4" /> Escribir por WhatsApp
      </a>
      <a href="/contacto/" class="btn btn-secondary btn-lg">Otros medios de contacto</a>

      <div slot="aside" class="rounded-panel border border-border bg-surface/80 p-6 shadow-card backdrop-blur-sm">
        <h2 class="flex items-center gap-2 font-sans text-sm font-semibold text-ink">
          <span class="grid h-8 w-8 place-items-center rounded-full bg-accent-soft text-brand-700">
            <Icon name="lucide:map-pinned" class="h-4 w-4" aria-hidden="true" />
          </span>
          Cobertura remota
        </h2>
        <ul class="mt-4 flex flex-wrap gap-1.5" role="list">
          {huilaMunicipios.map((m) => <li class="chip">{m}</li>)}
        </ul>
        <p class="mt-4 text-xs text-muted">Y demás municipios del departamento.</p>
      </div>
    </PageHero>

    <section class="section section-dark" aria-labelledby="huila-pasos">
      <div class="container-x">
        <SectionHeader
          id="huila-pasos"
          tone="dark"
          eyebrow="Cómo funciona"
          title="Asesoría contable a distancia, paso a paso"
          subtitle="Sin necesidad de desplazarse ni de que el contador esté físicamente en su municipio."
        />
        <ol class="section-body grid gap-5 md:grid-cols-3 lg:gap-6" data-stagger="90">
          {steps.map((s, i) => (
            <li class="reveal relative flex flex-col gap-5 rounded-card border border-white/10 bg-white/[0.04] p-7 sm:p-8">
              <div class="flex items-start justify-between">
                <span class="grid h-12 w-12 place-items-center rounded-2xl bg-white/10 text-accent ring-1 ring-inset ring-white/15">
                  <Icon name={s.icon} class="h-6 w-6" aria-hidden="true" />
                </span>
                <span class="font-serif text-4xl font-medium leading-none tracking-tight text-white/25" aria-hidden="true">0{i + 1}</span>
              </div>
              <h3 class="text-white"><span class="sr-only">Paso {i + 1}: </span>{s.title}</h3>
              <p class="leading-relaxed text-white/75">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <LocalServices title="Servicios disponibles para el Huila" subtitle="Portafolio de asesoría contable y tributaria disponible de forma remota." items={localServices} />

    <LocalFaq faqs={faqs} name="faq-huila" title="Dudas comunes sobre asesoría contable a distancia"
      other={{ label: '¿Está en Florencia o el Caquetá?', text: 'Puede agendar también una cita presencial en la oficina de Florencia.', href: '/florencia-caqueta/', cta: 'Ver atención en Florencia' }} />

    <CtaFinal />
  </main>

  <Footer />
</Layout>
