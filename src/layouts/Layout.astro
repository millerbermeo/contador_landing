---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import { localBusinessSchema } from '../data/schema';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: string;
  publishedTime?: string;
  schema?: Record<string, any>;
  includeOrgSchema?: boolean;
}

const {
  title = 'Líderes en Contabilidad | Asesoría Contable y Fiscal en Colombia',
  description = 'Contador Público certificado en Colombia. Asesoría contable, tributaria y fiscal para empresas y personas naturales. Florencia, Caquetá.',
  image = '/og-image.jpg',
  canonical,
  type,
  publishedTime,
  schema,
  includeOrgSchema = true,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={SITE.fullName} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/jpeg" href="/logotipo.jpeg" />

    <SeoHead {title} {description} {canonical} {image} {type} {publishedTime} schema={{ ...(includeOrgSchema ? localBusinessSchema() : {}), ...schema }} />
  </head>

  <body>
    <slot />

    <script>
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll('.reveal');

      if (prefersReduced || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const el = entry.target;
                const delay = el.dataset.revealDelay;
                if (delay) el.style.transitionDelay = `${delay}ms`;
                el.classList.add('is-visible');
                obs.unobserve(el);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
