---
/**
 * Layout base del sitio.
 * - Centraliza <head> (SEO/OG) e importa el sistema de diseño.
 * - Incluye el motor de scroll-reveal (IntersectionObserver) que respeta
 *   prefers-reduced-motion, disponible para todas las secciones vía `.reveal`.
 */
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = 'Brian Pedraza Osorio | Contador Público en Colombia — Asesoría Contable y Fiscal',
	description = 'Contador Público certificado en Colombia. Asesoría contable, tributaria y fiscal para empresas y personas naturales. Cumplimiento legal, optimización fiscal y soporte personalizado. Florencia, Caquetá.',
	image = '/og-image.jpg',
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Brian Pedraza Osorio" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/jpeg" href="/logotipo.jpeg" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:locale" content="es_CO" />
		<meta property="og:site_name" content="BP Asesorías Contables" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />

		<!-- Datos estructurados -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'ProfessionalService',
			name: 'BP Asesorías Contables',
			description: 'Contador Público con servicios de asesoría contable, tributaria y fiscal en Colombia.',
			telephone: '+573054188289',
			email: 'b.pedraza247@gmail.com',
			address: { '@type': 'PostalAddress', addressLocality: 'Florencia', addressRegion: 'Caquetá', addressCountry: 'CO' },
			founder: { '@type': 'Person', name: 'Brian Pedraza Osorio', jobTitle: 'Contador Público' },
			sameAs: ['https://www.tiktok.com/@bp.asesorias.contables'],
		})} />
	</head>

	<body>
		<slot />

		<script>
			// ─── Scroll-reveal centralizado ───────────────────────────
			const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const els = document.querySelectorAll<HTMLElement>('.reveal');

			if (prefersReduced || !('IntersectionObserver' in window)) {
				els.forEach((el) => el.classList.add('is-visible'));
			} else {
				const io = new IntersectionObserver(
					(entries, obs) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								const el = entry.target as HTMLElement;
								const delay = el.dataset.revealDelay;
								if (delay) el.style.transitionDelay = `${delay}ms`;
								el.classList.add('is-visible');
								obs.unobserve(el);
							}
						});
					},
					{ threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
				);
				els.forEach((el) => io.observe(el));
			}
		</script>
	</body>
</html>
